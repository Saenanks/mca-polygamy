+    private static final int LONG_PATH_NODES = 4000;
+    /** Blocks per tick she swims at. */
+    private static final double SWIM_SPEED = 0.07;
+
+    private enum Phase {IDLE, TALKING, WALKING, ENTERING, SWIMMING, LEAVING}
+
+    private Phase phase = Phase.IDLE;
+    private long phaseStart;
+    private long swimEnd;
+    private long nextMove;
+    private long planDay = -1;
