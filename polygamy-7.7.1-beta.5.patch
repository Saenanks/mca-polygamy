+            s.velZ += (-k * s.posZ - c * s.velZ) * h;
+            s.posZ += s.velZ * h;
+        }
+        float limit = show != 0 ? SHOW_MAX_OFFSET : MAX_OFFSET;
+        s.posY = Mth.clamp(s.posY, -limit, limit);
+        s.posZ = Mth.clamp(s.posZ, -limit, limit);
+
+        s.result[0] = s.posY;
+        s.result[1] = s.posZ;
+        return s.result;
