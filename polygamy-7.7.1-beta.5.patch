+    /**
+     * ModelPart.copyFrom only copies the part itself, not its children, so the lean of the two breasts has to be copied
+     * separately whenever a breast part is copied to another model (clothing, armor, the worn layer).
+     */
+    static void copyBreastLean(ModelPart from, ModelPart to) {
+        for (String side : new String[]{"left", "right"}) {
+            if (from.hasChild(side) && to.hasChild(side)) {
+                ModelPart source = from.getChild(side);
+                ModelPart target = to.getChild(side);
+                target.xRot = source.xRot;
+                target.yRot = source.yRot;
+                target.zRot = source.zRot;
+            }
+        }
+    }
+
+    default void applyBreastLean(ModelPart breasts, String side, float xRot, float lean) {
+        if (!breasts.hasChild(side)) {
+            return;
         }
+        double c = Math.cos(xRot);
+        double s = Math.sin(xRot);
+        double cl = Math.cos(lean);
+        double sl = Math.sin(lean);
+        // Rx(a) and Rz(l) as 3x3 matrices, R = Rx(-a) * Rz(l) * Rx(a)
+        double[][] rx = {{1, 0, 0}, {0, c, -s}, {0, s, c}};
+        double[][] rxInv = {{1, 0, 0}, {0, c, s}, {0, -s, c}};
+        double[][] rz = {{cl, -sl, 0}, {sl, cl, 0}, {0, 0, 1}};
+        double[][] r = multiply(rxInv, multiply(rz, rx));
+        // R = Rz(z) * Ry(y) * Rx(x)
+        double y = -Math.asin(Math.max(-1.0, Math.min(1.0, r[2][0])));
+        double x = Math.atan2(r[2][1], r[2][2]);
+        double z = Math.atan2(r[1][0], r[0][0]);
+        ModelPart child = breasts.getChild(side);
+        child.xRot = (float)x;
+        child.yRot = (float)y;
+        child.zRot = (float)z;
+    }
+
+    private static double[][] multiply(double[][] a, double[][] b) {
+        double[][] out = new double[3][3];
+        for (int i = 0; i < 3; i++) {
+            for (int j = 0; j < 3; j++) {
+                for (int k = 0; k < 3; k++) {
+                    out[i][j] += a[i][k] * b[k][j];
+                }
+            }
+        }
+        return out;
+    }
+
+    // Extended range addon. Identical to the original formulas up to 100%, slower growth above it so large sizes stay on the torso.
+    float BREAST_TOP_LIMIT = 0.83f;
+    float BREAST_BACK_LIMIT = 1.8f;
+    float BREAST_ATTACH_LIMIT = -1.95f;
+
+    // Depth growth stops at the size where the full tilt (54 degrees) still fits between the chest and the back of the torso
+    // ((BACK - ATTACH) / (3 * sin(54 degrees)) = 1.545, reached at about 177%). With the depth capped the tilt never has to ease off,
+    // so the top of the breast stays longer than the underside at every size.
+    float BREAST_DEPTH_SCALE_MAX = 1.545f;
+
+    default float breastScaleZ(float size) {
+        return Math.min(size * 0.45F + 0.75F, BREAST_DEPTH_SCALE_MAX);
+    }
+
+    default float breastScaleX(float size) {
+        return size <= 1.0f ? size * 0.2F + 1.05F : 1.25F + (size - 1.0f) * 0.08F;
+    }
+
+    default float breastScaleY(float size) {
+        return size <= 1.0f ? size * 0.75F + 0.75F : 1.5F + (size - 1.0f) * 0.25F;
     }
 
