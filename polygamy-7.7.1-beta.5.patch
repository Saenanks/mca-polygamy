+package net.conczin.mca.client;
+
+import com.google.gson.Gson;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.mojang.blaze3d.platform.NativeImage;
+import net.conczin.mca.MCA;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.renderer.texture.DynamicTexture;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.server.packs.resources.ResourceManager;
+import org.apache.commons.io.FileUtils;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.*;
+
+/**
+ * Client side store for special outfits (sleepwear and swimwear).
+ * <ul>
+ *   <li>Built-in outfits: {@code assets/<ns>/skins/clothing/special/<kind>/<gender>/*.png}, also from resource packs.</li>
+ *   <li>Saved outfits (from the player made skin library): {@code ./mca_outfits/<kind>/<gender>/*.png}. Drop your own 64x64 PNGs in there too.</li>
+ *   <li>The outfit chosen for each villager is kept in {@code ./mca_outfits/assignments.json}.</li>
+ * </ul>
+ * Choices are stored on this computer, so only you see them (also on servers).
+ */
+public final class OutfitStore {
+    public static final String SLEEPWEAR = "sleepwear";
+    public static final String SWIMWEAR = "swimwear";
+    /** Assignment value meaning "keep her normal clothes for this situation". */
+    public static final String NONE = "none";
+
+    private static final File DIR = new File("./mca_outfits");
+    private static final long REFRESH_MILLIS = 5000;
+
+    public record Outfit(String id, String label, ResourceLocation texture) {
+    }
+
+    private static final Map<String, List<Outfit>> LISTS = new HashMap<>();
+    private static long lastRefresh = 0;
+    private static final Map<String, Long> LOADED_TIMES = new HashMap<>();
+    private static Map<String, Map<String, String>> assignments;
+
+    private OutfitStore() {
+    }
+
+    // ---- listing ----
+
+    public static synchronized List<Outfit> list(String kind, String gender) {
+        long time = System.currentTimeMillis();
+        if (time - lastRefresh > REFRESH_MILLIS) {
+            LISTS.clear();
+            lastRefresh = time;
+        }
+        return LISTS.computeIfAbsent(kind + "/" + gender, key -> {
+            List<Outfit> result = new ArrayList<>();
+
+            ResourceManager manager = Minecraft.getInstance().getResourceManager();
+            List<ResourceLocation> builtin = new ArrayList<>(manager
+                    .listResources("skins/clothing/special/" + key, l -> l.getPath().endsWith(".png"))
+                    .keySet());
+            builtin.sort(Comparator.comparing(ResourceLocation::toString));
+            for (ResourceLocation r : builtin) {
+                String name = r.getPath().substring(r.getPath().lastIndexOf('/') + 1).replace(".png", "").replace('_', ' ');
+                result.add(new Outfit(r.toString(), name, r));
+            }
+
+            File[] files = new File(DIR, key).listFiles((d, n) -> n.toLowerCase(Locale.ROOT).endsWith(".png"));
+            if (files != null) {
+                Arrays.sort(files);
+                for (File f : files) {
+                    ResourceLocation tex = loadUserTexture(kind + "/" + gender + "/" + f.getName(), f);
+                    if (tex != null) {
+                        result.add(new Outfit("user:" + kind + "/" + gender + "/" + f.getName(),
+                                f.getName().replace(".png", "").replace('_', ' '), tex));
+                    }
+                }
+            }
+            return result;
+        });
+    }
+
+    private static ResourceLocation loadUserTexture(String relative, File file) {
+        String path = "outfits_user/" + relative.toLowerCase(Locale.ROOT).replaceAll("[^a-z0-9/._-]", "_");
+        ResourceLocation location = new ResourceLocation(MCA.MOD_ID, path);
+        Long loaded = LOADED_TIMES.get(path);
+        if (loaded != null && loaded == file.lastModified()) {
+            return location;
+        }
+        try (FileInputStream in = new FileInputStream(file)) {
+            NativeImage image = NativeImage.read(in);
+            Minecraft.getInstance().getTextureManager().register(location, new DynamicTexture(image));
+            LOADED_TIMES.put(path, file.lastModified());
+            return location;
+        } catch (IOException | RuntimeException e) {
+            MCA.LOGGER.warn("Could not load outfit {}", file, e);
+            return null;
+        }
+    }
+
+    /** Saves a skin from the library as an outfit. Returns the saved file name relative to the game folder. */
+    public static synchronized String save(String kind, String gender, String name, NativeImage image) throws IOException {
+        File dir = new File(DIR, kind + "/" + gender);
+        //noinspection ResultOfMethodCallIgnored
+        dir.mkdirs();
+        File file = new File(dir, name + ".png");
+        image.writeToFile(file);
+        lastRefresh = 0;
+        return "mca_outfits/" + kind + "/" + gender + "/" + file.getName();
+    }
+
+    // ---- per villager choice ----
+
+    private static synchronized Map<String, Map<String, String>> assignments() {
+        if (assignments == null) {
+            assignments = new HashMap<>();
+            File file = new File(DIR, "assignments.json");
+            if (file.exists()) {
+                try {
+                    JsonObject root = JsonParser.parseString(FileUtils.readFileToString(file, StandardCharsets.UTF_8)).getAsJsonObject();
+                    for (String uuid : root.keySet()) {
+                        Map<String, String> m = new HashMap<>();
+                        JsonObject o = root.getAsJsonObject(uuid);
+                        for (String kind : o.keySet()) {
+                            m.put(kind, o.get(kind).getAsString());
+                        }
+                        assignments.put(uuid, m);
+                    }
+                } catch (Exception e) {
+                    MCA.LOGGER.warn("Could not read outfit assignments", e);
+                }
+            }
+        }
+        return assignments;
+    }
+
+    /** The saved choice id for this villager, or null for "automatic". */
+    public static synchronized String getChoice(UUID villager, String kind) {
+        Map<String, String> m = assignments().get(villager.toString());
+        return m == null ? null : m.get(kind);
+    }
+
+    public static synchronized void setChoice(UUID villager, String kind, String id) {
+        Map<String, Map<String, String>> a = assignments();
+        if (id == null) {
+            Map<String, String> m = a.get(villager.toString());
+            if (m != null) m.remove(kind);
+        } else {
+            a.computeIfAbsent(villager.toString(), k -> new HashMap<>()).put(kind, id);
+        }
+        try {
+            //noinspection ResultOfMethodCallIgnored
+            DIR.mkdirs();
+            FileUtils.writeStringToFile(new File(DIR, "assignments.json"), new Gson().toJson(a), StandardCharsets.UTF_8);
+        } catch (IOException e) {
+            MCA.LOGGER.warn("Could not save outfit assignments", e);
+        }
+    }
+
+    /**
+     * What this villager wears for the given situation.
+     * Returns null for "no special outfit" (normal clothes), otherwise the texture. Automatic choice picks by unique id.
+     */
+    public static ResourceLocation resolve(UUID villager, String kind, String gender) {
+        String choice = getChoice(villager, kind);
+        if (NONE.equals(choice)) {
+            return null;
+        }
+        List<Outfit> options = list(kind, gender);
+        if (options.isEmpty()) {
+            return null;
+        }
+        if (choice != null) {
+            for (Outfit o : options) {
+                if (o.id().equals(choice)) return o.texture();
+            }
+        }
+        return options.get(Math.floorMod(villager.hashCode(), options.size())).texture();
+    }
+}
