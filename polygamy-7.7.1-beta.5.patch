@@ -0,0 +1,197 @@
+package net.conczin.mca.server.outfits;
+
+import com.google.gson.Gson;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import net.conczin.mca.MCA;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.world.level.storage.LevelResource;
+import org.apache.commons.io.FileUtils;
+
+import javax.imageio.ImageIO;
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayInputStream;
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import java.util.regex.Pattern;
+
+/**
+ * Server side storage of outfit textures, so that other players can see the outfits villagers wear, and so that a player's saved
+ * outfits survive if the local outfit folder is lost.
+ * <ul>
+ *   <li>{@code <world>/mca_outfits/textures/<sha1>.png}: every uploaded texture, shared by everybody.</li>
+ *   <li>{@code <world>/mca_outfits/library/<player uuid>.json}: the outfits each player saved (name, library id), by texture hash.</li>
+ * </ul>
+ */
+public final class OutfitServerStore {
+    /** The largest texture accepted, in bytes (it also has to fit into one network message). */
+    public static final int MAX_BYTES = 28000;
+    private static final int MAX_LIBRARY = 300;
+    private static final Pattern HASH = Pattern.compile("[0-9a-f]{40}");
+    private static final byte[] PNG_SIGNATURE = {(byte) 0x89, 'P', 'N', 'G', 0x0D, 0x0A, 0x1A, 0x0A};
+    private static final Gson GSON = new Gson();
+
+    private OutfitServerStore() {
+    }
+
+    public static boolean isValidHash(String hash) {
+        return hash != null && HASH.matcher(hash).matches();
+    }
+
+    public static String hash(byte[] data) {
+        try {
+            byte[] digest = MessageDigest.getInstance("SHA-1").digest(data);
+            StringBuilder sb = new StringBuilder();
+            for (byte b : digest) {
+                sb.append(String.format("%02x", b));
+            }
+            return sb.toString();
+        } catch (Exception e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    private static File dir(MinecraftServer server, String sub) {
+        File dir = new File(server.getWorldPath(LevelResource.ROOT).toFile(), "mca_outfits/" + sub);
+        //noinspection ResultOfMethodCallIgnored
+        dir.mkdirs();
+        return dir;
+    }
+
+    /** Stores the texture if it is a small PNG. Returns its hash, or null if it was rejected. */
+    public static synchronized String storeTexture(MinecraftServer server, byte[] png) {
+        if (png == null || png.length < PNG_SIGNATURE.length || png.length > MAX_BYTES) {
+            return null;
+        }
+        for (int i = 0; i < PNG_SIGNATURE.length; i++) {
+            if (png[i] != PNG_SIGNATURE[i]) return null;
+        }
+        try {
+            BufferedImage image = ImageIO.read(new ByteArrayInputStream(png));
+            if (image == null || image.getWidth() > 128 || image.getHeight() > 128) {
+                return null;
+            }
+            String hash = hash(png);
+            File file = new File(dir(server, "textures"), hash + ".png");
+            if (!file.exists()) {
+                FileUtils.writeByteArrayToFile(file, png);
+            }
+            return hash;
+        } catch (IOException e) {
+            MCA.LOGGER.warn("Could not store an outfit texture", e);
+            return null;
+        }
+    }
+
+    public static synchronized byte[] readTexture(MinecraftServer server, String hash) {
+        if (!isValidHash(hash)) return null;
+        File file = new File(dir(server, "textures"), hash + ".png");
+        try {
+            return file.exists() ? FileUtils.readFileToByteArray(file) : null;
+        } catch (IOException e) {
+            return null;
+        }
+    }
+
+    // ---- per player library ----
+
+    public record Entry(String hash, String name, int contentId) {
+    }
+
+    private static File libraryFile(MinecraftServer server, UUID player) {
+        return new File(dir(server, "library"), player + ".json");
+    }
+
+    public static synchronized List<Entry> getLibrary(MinecraftServer server, UUID player) {
+        List<Entry> result = new ArrayList<>();
+        File file = libraryFile(server, player);
+        if (file.exists()) {
+            try {
+                JsonObject root = JsonParser.parseString(FileUtils.readFileToString(file, StandardCharsets.UTF_8)).getAsJsonObject();
+                for (String hash : root.keySet()) {
+                    JsonObject o = root.getAsJsonObject(hash);
+                    result.add(new Entry(hash, o.has("name") ? o.get("name").getAsString() : hash,
+                            o.has("contentid") ? o.get("contentid").getAsInt() : 0));
+                }
+            } catch (Exception e) {
+                MCA.LOGGER.warn("Could not read the outfit library of {}", player, e);
+            }
+        }
+        return result;
+    }
+
+    private static void writeLibrary(MinecraftServer server, UUID player, List<Entry> entries) {
+        Map<String, Object> root = new LinkedHashMap<>();
+        for (Entry e : entries) {
+            Map<String, Object> o = new LinkedHashMap<>();
+            o.put("name", e.name());
+            o.put("contentid", e.contentId());
+            root.put(e.hash(), o);
+        }
+        try {
+            FileUtils.writeStringToFile(libraryFile(server, player), GSON.toJson(root), StandardCharsets.UTF_8);
+        } catch (IOException ex) {
+            MCA.LOGGER.warn("Could not write the outfit library of {}", player, ex);
+        }
+    }
+
+    public static synchronized void addToLibrary(MinecraftServer server, UUID player, String hash, String name, int contentId) {
+        List<Entry> entries = getLibrary(server, player);
+        entries.removeIf(e -> e.hash().equals(hash));
+        if (entries.size() >= MAX_LIBRARY) {
+            return;
+        }
+        entries.add(new Entry(hash, name == null || name.isBlank() ? hash : name, contentId));
+        writeLibrary(server, player, entries);
+    }
+
+    public static synchronized void removeFromLibrary(MinecraftServer server, UUID player, String hash) {
+        List<Entry> entries = getLibrary(server, player);
+        if (entries.removeIf(e -> e.hash().equals(hash))) {
+            writeLibrary(server, player, entries);
+        }
+    }
+
+    // ---- which outfits are in the player's swimwear and sleepwear tabs ----
+
+    private static File listsFile(MinecraftServer server, UUID player) {
+        return new File(dir(server, "lists"), player + ".json");
+    }
+
+    public static synchronized List<String> getList(MinecraftServer server, UUID player, String kind) {
+        List<String> result = new ArrayList<>();
+        File file = listsFile(server, player);
+        if (file.exists()) {
+            try {
+                JsonObject root = JsonParser.parseString(FileUtils.readFileToString(file, StandardCharsets.UTF_8)).getAsJsonObject();
+                if (root.has(kind)) {
+                    root.getAsJsonArray(kind).forEach(e -> {
+                        if (isValidHash(e.getAsString())) result.add(e.getAsString());
+                    });
+                }
+            } catch (Exception e) {
+                MCA.LOGGER.warn("Could not read the outfit lists of {}", player, e);
+            }
+        }
+        return result;
+    }
+
+    public static synchronized void setList(MinecraftServer server, UUID player, String kind, List<String> hashes) {
+        Map<String, Object> root = new LinkedHashMap<>();
+        for (String k : new String[]{"swimwear", "sleepwear"}) {
+            root.put(k, k.equals(kind) ? hashes : getList(server, player, k));
+        }
+        try {
+            FileUtils.writeStringToFile(listsFile(server, player), GSON.toJson(root), StandardCharsets.UTF_8);
+        } catch (IOException e) {
+            MCA.LOGGER.warn("Could not write the outfit lists of {}", player, e);
+        }
+    }
+}
