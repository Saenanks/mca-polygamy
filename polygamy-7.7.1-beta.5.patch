+package net.conczin.mca.entity.ai;
+
+import com.google.gson.Gson;
+import com.google.gson.GsonBuilder;
+import com.google.gson.JsonObject;
+import com.google.gson.reflect.TypeToken;
+import net.conczin.mca.MCA;
+import net.conczin.mca.entity.VillagerEntityMCA;
+import net.conczin.mca.entity.VillagerLike;
+import net.conczin.mca.entity.ai.relationship.AgeState;
+import net.conczin.mca.entity.ai.relationship.Gender;
+import net.minecraft.network.chat.Component;
+import net.minecraft.server.level.ServerPlayer;
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.io.Reader;
+import java.io.Writer;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Deviant addon: the extra lines a Deviant villager says for flirt, chat, kiss and hug. They are added to the normal
+ * dialogue pool, so every line (normal or custom) is equally likely. A female adult villager becomes Deviant once her
+ * relationship with a player reaches 400 hearts.
+ * The lines live in config/mca_deviant_lines.json. The file is created with the defaults below on first use
+ * and is re-read automatically whenever it changes, so it can be edited without rebuilding the mod.
+ */
+public final class DeviantLines {
+    /** Hearts a player needs with the villager before she becomes Deviant and uses these lines. */
+    public static final int HEARTS_REQUIRED = 400;
+
+    private static final Gson GSON = new GsonBuilder().setPrettyPrinting().disableHtmlEscaping().create();
+    private static final File FILE = new File("./config/mca_deviant_lines.json");
+
+    private static final Map<String, String> DIALOGUE_TO_CATEGORY = Map.of(
+            "flirt.success", "flirt",
+            "chat.topic", "chat",
+            "kiss.success", "kiss",
+            "hug.success", "hug"
+    );
+
+    private static final Set<String> NEVER_NEGATIVE = Set.of("flirt", "chat", "kiss", "hug");
+
+    private static final Map<String, Integer> VANILLA_COUNTS = new HashMap<>();
+
+    private static Map<String, List<String>> lines = defaults();
+    private static long loadedStamp = Long.MIN_VALUE;
+
+    private DeviantLines() {
+    }
+
+    /**
+     * Sometimes sends a custom line instead of the normal reply when this villager qualifies. Every normal line and every
+     * custom line is equally likely, so the custom lines join the normal pool.
+     *
+     * @return true if a custom line was sent and the normal reply should be skipped.
+     */
+    public static boolean tryHandle(VillagerEntityMCA villager, ServerPlayer player, String dialogueId) {
+        String category = DIALOGUE_TO_CATEGORY.get(dialogueId);
+        if (category == null) {
+            return false;
+        }
+
+        if (!isEligible(villager, villager.getVillagerBrain().getMemoriesForPlayer(player))) {
+            return false;
+        }
+
+        List<String> options = getLines(category);
+        if (options.isEmpty()) {
+            return false;
+        }
+
+        // one draw over the custom lines plus the normal ones; landing on a normal one means the normal reply is used
+        int pick = villager.getRandom().nextInt(options.size() + vanillaLineCount(dialogueId));
+        if (pick >= options.size()) {
+            return false;
+        }
+        villager.sendChatMessage(Component.literal(options.get(pick)), player);
+        return true;
+    }
+
+    /**
+     * Female, adult and at 400 hearts or more with the given player: she is Deviant, and gets the trait now if she did
+     * not have it yet.
+     */
+    public static boolean isEligible(VillagerLike<?> villager, Memories memories) {
+        if (!Traits.DEVIANT.isEnabled()
+                || villager.getGenetics().getGender() != Gender.FEMALE
+                || villager.asEntity().isBaby()
+                || !isAdult(villager.getAgeState())
+                || memories.getHearts() < HEARTS_REQUIRED) {
+            return false;
+        }
+        if (!villager.getTraits().hasTrait(Traits.DEVIANT)) {
+            villager.getTraits().addTrait(Traits.DEVIANT);
+        }
+        return villager.getTraits().hasTrait(Traits.DEVIANT);
+    }
+
+    /**
+     * Called whenever a villager's memory of a player changes, so she becomes Deviant as soon as the relationship reaches 400 hearts.
+     */
+    public static void grantTraitIfEligible(VillagerLike<?> villager, Memories memories) {
+        if (!villager.asEntity().level().isClientSide) {
+            isEligible(villager, memories);
+        }
+    }
+
+    /** Number of normal replies the game has for this interaction, so the custom lines can be mixed in fairly. */
+    private static synchronized int vanillaLineCount(String dialogueId) {
+        return VANILLA_COUNTS.computeIfAbsent(dialogueId, id -> {
+            String prefix = "dialogue." + (id.equals("chat.topic") ? "chat.success" : id) + "/";
+            try (Reader reader = new InputStreamReader(DeviantLines.class.getResourceAsStream("/assets/mca_dialogue/lang/en_us.json"), StandardCharsets.UTF_8)) {
+                JsonObject json = GSON.fromJson(reader, JsonObject.class);
+                int count = 0;
+                for (String key : json.keySet()) {
+                    if (key.startsWith(prefix)) {
+                        count++;
+                    }
+                }
+                return Math.max(1, count);
+            } catch (Exception e) {
+                return 8;
+            }
+        });
+    }
+
+    /** Deviant villagers never answer flirt, chat, kiss or hug negatively. */
+    public static boolean avoidsNegativeAnswers(VillagerLike<?> villager, String questionId) {
+        return NEVER_NEGATIVE.contains(questionId) && villager.getTraits().hasTrait(Traits.DEVIANT);
+    }
+
+    public static boolean isAdult(AgeState age) {
+        return age == AgeState.ADULT || age == AgeState.UNASSIGNED;
+    }
+
+    private static synchronized List<String> getLines(String category) {
+        reloadIfChanged();
+        return lines.getOrDefault(category, List.of());
+    }
+
+    private static void reloadIfChanged() {
+        long stamp = FILE.exists() ? FILE.lastModified() : -1;
+        if (stamp == loadedStamp) {
+            return;
+        }
+        loadedStamp = stamp;
+
+        if (stamp == -1) {
+            lines = defaults();
+            try {
+                File parent = FILE.getParentFile();
+                if (parent != null) {
+                    parent.mkdirs();
+                }
+                try (Writer writer = Files.newBufferedWriter(FILE.toPath(), StandardCharsets.UTF_8)) {
+                    GSON.toJson(lines, writer);
+                }
+                loadedStamp = FILE.lastModified();
+            } catch (IOException e) {
+                MCA.LOGGER.warn("Could not write {}", FILE, e);
+            }
+            return;
+        }
+
+        try (Reader reader = Files.newBufferedReader(FILE.toPath(), StandardCharsets.UTF_8)) {
+            Map<String, List<String>> loaded = GSON.fromJson(reader, new TypeToken<Map<String, List<String>>>() {
+            }.getType());
+            Map<String, List<String>> result = new LinkedHashMap<>();
+            if (loaded != null) {
+                loaded.forEach((key, value) -> {
+                    List<String> cleaned = new ArrayList<>();
+                    if (value != null) {
+                        for (String line : value) {
+                            if (line != null && !line.isBlank()) {
+                                cleaned.add(line);
+                            }
+                        }
+                    }
+                    result.put(key, cleaned);
+                });
+            }
+            lines = result;
+        } catch (Exception e) {
+            MCA.LOGGER.warn("Could not read {}, using the built-in lines instead", FILE, e);
+            lines = defaults();
+        }
+    }
+
+    private static Map<String, List<String>> defaults() {
+        Map<String, List<String>> map = new LinkedHashMap<>();
+        map.put("flirt", List.of(
+                "You've been teasing me all day, and I'm done being patient. Come here.",
+                "Do you have any idea how badly I want you right now? Because I'm not hiding it anymore.",
+                "Keep talking like that and I'll make sure you don't leave this room for hours.",
+                "I'm not a patient woman, and you're making me wait. That's cruel.",
+                "Say the word and I'll show you what I've been thinking about every night.",
+                "I've been watching you all day, planning exactly how this ends. Want to hear it?",
+                "You smile like that again and I'm going to forget we're in public.",
+                "I don't want to be good tonight. I want to be yours.",
+                "Come closer. I want to tell you something I definitely shouldn't say out loud.",
+                "You have no idea how much self-control it takes not to grab you right now.",
+                "I've been behaving all day. Don't tempt me into stopping now.",
+                "You look at me like you're deciding where to start. I'd love to hear the plan.",
+                "I could get used to you looking at me like that. Just don't stop.",
+                "You're trouble, and I've decided I like trouble.",
+                "Tell me what you're thinking right now. I bet it's something I'd enjoy.",
+                "Every time you smile at me, I lose a little more of my self-control.",
+                "If you're going to flirt with me, you'd better be ready for me to flirt back.",
+                "I've got a few ideas for how we could spend tonight. Interested?",
+                "You're not subtle, you know. Not that I mind one bit.",
+                "Come closer. I promise I only bite a little.",
+                "" ));
+        map.put("chat", List.of(
+                "Sorry, I can't focus on a word you're saying. Not with you looking at me like that.",
+                "I'd love to chat... but all I can think about is getting you alone.",
+                "Everyone else sees a quiet villager. You get the version that wants to ruin your plans for the evening.",
+                "You're lucky there are people around, or I'd have you pinned against that wall by now.",
+                "I've got a lot of ideas about what to do with you. None of them are polite.",
+                "You talk, I watch your mouth. I'm not hearing a thing you're saying.",
+                "I swear, every time you walk in I forget how to act normal.",
+                "If we were alone, this conversation would have been over about thirty seconds ago.",
+                "You're making it very hard to be well-behaved, you know that?",
+                "I had a whole day planned, and then you showed up and ruined it. Beautifully.",
+                "I'm listening, really. I'm just distracted by how good you look.",
+                "Be careful how you talk to me. I might take it the wrong way... on purpose.",
+                "Talk to me. I love hearing your voice, especially when it gets all low.",
+                "You've got me thinking things I'd never say in front of the village.",
+                "If we weren't standing in the open, I'd have a very different conversation with you.",
+                "I'll be honest, I came over just to see if you'd notice me. You did.",
+                "Everyone thinks I'm sweet. You're the only one who's seen what I'm really like.",
+                "Keep that voice up and I'll agree to anything you ask.",
+                "I wasn't planning on being this bold today. You're a bad influence.",
+                "Funny how every conversation with you turns into something I want to continue in private.",
+                "" ));
+        map.put("kiss", List.of(
+                "Mmm... that kiss lit me up. Now I'm burning for more.",
+                "If you kiss me like that again, we're not stopping. I'm warning you.",
+                "I felt that kiss everywhere. Don't you dare walk away now.",
+                "My whole body's humming after that. Take me somewhere, now.",
+                "That wasn't nearly enough. Kiss me again, and don't hold back this time.",
+                "Mmm, don't stop. I want to feel your lips on me for the rest of the night.",
+                "One kiss and I'm already thinking about the next ten. Come here.",
+                "That kiss told me everything I needed to know. Now be brave and follow through.",
+                "You taste like trouble, and I'm absolutely going to enjoy it.",
+                "I'm all flushed and breathless... and that was just a kiss. Imagine what comes next.",
+                "Mmm... I can tell exactly how much you liked that. My eyes just wandered south of your belt, and you're not hiding it very well.",
+                "That kiss got a very honest reaction out of you, and I can see it from here. I'm curious what else you'd be honest about.",
+                "Mmm, that kiss had an effect on you, didn't it? Don't look away. I already noticed.",
+                "I felt you react the second our lips met. You can't hide that from me.",
+                "One kiss and you're already this worked up? Now I'm tempted to see how far it goes.",
+                "Mmm, you kiss like you mean it, and your body agrees. I can see exactly how much you liked it.",
+                "That kiss didn't go unnoticed. Neither did your reaction. Care to explain?",
+                "Your lips say one thing, but the rest of you is being very honest with me.",
+                "I barely touched you and you're already this eager. I love that.",
+                "Keep kissing me like that, and I'll find out just how eager you really are.",
+                "" ));
+        map.put("hug", List.of(
+                "You hold me like that and I forget everything but how close you are.",
