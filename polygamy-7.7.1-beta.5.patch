+package net.conczin.mca.entity.ai;
+
+import net.conczin.mca.entity.VillagerEntityMCA;
+import net.conczin.mca.entity.ai.relationship.Gender;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.util.Mth;
+
+/**
+ * Pregnant breasts addon: after a female villager has procreated with her spouse her breasts grow by an extra 50 points
+ * on the 0 to 300% scale (never past 300%). Over the next 7 in-game days they shrink back, one small step at a time, to the
+ * size she had before. She carries the "Pregnant breasts" trait for as long as this lasts and loses it at the end.
+ * <p>
+ * The state is kept as a few extra keys next to the traits: when the effect started, the size she had before it, the size
+ * this class last wrote, and how much was added at the start. If the breast slider is moved in the editor meanwhile,
+ * the change is kept and the effect carries on from the new size.
+ */
+public final class PregnantBreasts {
+    /** The extra size at the start, on the same scale as the breast gene (0.5 = 50%). */
+    public static final float BOOST = 0.5f;
+    /** 7 in-game days. */
+    public static final long DURATION = 7 * 24000L;
+
+    private static final String START_KEY = "mca:pregnant_breasts_start";
+    private static final String BASE_KEY = "mca:pregnant_breasts_base";
+    private static final String APPLIED_KEY = "mca:pregnant_breasts_applied";
+    private static final String BOOST_KEY = "mca:pregnant_breasts_boost";
+
+    private PregnantBreasts() {
+    }
+
+    /** Called when a female villager has just procreated with her spouse. Starting again restarts the 7 days. */
+    public static void start(VillagerEntityMCA villager) {
+        if (villager.level().isClientSide
+                || !Traits.PREGNANT_BREASTS.isEnabled()
+                || villager.getGenetics().getGender() != Gender.FEMALE) {
+            return;
+        }
+
+        Traits traits = villager.getTraits();
+        // bring a running effect up to date first, so the size she had before it is known exactly
+        if (traits.hasTrait(Traits.PREGNANT_BREASTS) && traits.getExtraData().contains(START_KEY)) {
+            update(villager);
+        }
+
+        CompoundTag tag = traits.getExtraData();
+        float gene = villager.getGenetics().getGene(Genetics.BREAST);
+        float base = traits.hasTrait(Traits.PREGNANT_BREASTS) && tag.contains(START_KEY) ? tag.getFloat(BASE_KEY) : gene;
+        float boost = Math.max(0.0f, Math.min(BOOST, Genetics.SLIDER_BREAST_MAX - base));
+        float target = Mth.clamp(base + boost, 0.0f, Genetics.SLIDER_BREAST_MAX);
+
+        traits.addTrait(Traits.PREGNANT_BREASTS);
+        tag = traits.getExtraData();
+        tag.putLong(START_KEY, villager.level().getDayTime());
+        tag.putFloat(BASE_KEY, base);
+        tag.putFloat(APPLIED_KEY, target);
+        tag.putFloat(BOOST_KEY, boost);
+        traits.setExtraData(tag);
+        villager.getGenetics().setGene(Genetics.BREAST, target);
+    }
+
+    /** Called every few seconds on the server: moves the size one step back towards normal, and ends the effect after 7 days. */
+    public static void update(VillagerEntityMCA villager) {
+        if (villager.level().isClientSide) {
+            return;
+        }
+
+        Traits traits = villager.getTraits();
+        CompoundTag tag = traits.getExtraData();
+        boolean hasTrait = traits.hasTrait(Traits.PREGNANT_BREASTS);
+        boolean hasData = tag.contains(START_KEY);
+        if (!hasTrait && !hasData) {
+            return;
+        }
+
+        if (hasTrait && !hasData) {
+            // the trait was given by hand (editor): it starts the effect, but only for females
+            if (villager.getGenetics().getGender() == Gender.FEMALE) {
+                start(villager);
+            } else {
+                traits.removeTrait(Traits.PREGNANT_BREASTS);
+            }
+            return;
+        }
+
+        float gene = villager.getGenetics().getGene(Genetics.BREAST);
+        float base = tag.getFloat(BASE_KEY);
+        float applied = tag.getFloat(APPLIED_KEY);
+        float boost = tag.getFloat(BOOST_KEY);
+        long start = tag.getLong(START_KEY);
+
+        // the breast slider was moved meanwhile: keep that change and carry on from there
+        boolean changed = false;
+        if (Math.abs(gene - applied) > 0.005f) {
+            base += gene - applied;
+            changed = true;
+        }
+
+        long now = villager.level().getDayTime();
+        if (now < start) {
+            // the time of day was set back
+            start = now;
+            changed = true;
+        }
+        long elapsed = now - start;
+
+        if (!hasTrait || elapsed >= DURATION) {
+            // finished (or the trait was taken away): back to the normal size, and the trait goes
+            tag.remove(START_KEY);
+            tag.remove(BASE_KEY);
+            tag.remove(APPLIED_KEY);
+            tag.remove(BOOST_KEY);
+            traits.setExtraData(tag);
+            if (hasTrait) {
+                traits.removeTrait(Traits.PREGNANT_BREASTS);
+            }
+            villager.getGenetics().setGene(Genetics.BREAST, Mth.clamp(base, 0.0f, Genetics.SLIDER_BREAST_MAX));
+            return;
+        }
+
+        float remaining = 1.0f - (float) elapsed / (float) DURATION;
+        float target = Mth.clamp(base + boost * remaining, 0.0f, Genetics.SLIDER_BREAST_MAX);
+        if (Math.abs(target - gene) > 0.001f) {
+            villager.getGenetics().setGene(Genetics.BREAST, target);
+            applied = target;
+            changed = true;
+        }
+
+        if (changed) {
+            tag.putLong(START_KEY, start);
+            tag.putFloat(BASE_KEY, base);
+            tag.putFloat(APPLIED_KEY, applied);
+            traits.setExtraData(tag);
+        }
+    }
+}
