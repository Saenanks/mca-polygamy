+        }
+        return lines.getOrDefault(category, List.of());
+    }
+
+    private static Map<String, List<String>> defaults() {
+        try (Reader reader = new InputStreamReader(BedtimeLines.class.getResourceAsStream("/assets/mca/bedtime_lines_default.json"), StandardCharsets.UTF_8)) {
