+    private static final Set<String> REFUSALS = Set.of("greet.negative", "busy", "goaway");
+
+    /** Deviant villagers never refuse to talk: no "I'm busy", "go away" or unfriendly greeting when you start a conversation. */
+    public static boolean avoidsRefusal(VillagerLike<?> villager, String questionId, String next) {
+        return "root".equals(questionId) && next != null && REFUSALS.contains(next) && villager.getTraits().hasTrait(Traits.DEVIANT);
