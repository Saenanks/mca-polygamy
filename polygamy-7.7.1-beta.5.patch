@@ -0,0 +1,38 @@
+package net.conczin.mca.network.c2s;
+
+import net.conczin.mca.cobalt.network.Message;
+import net.conczin.mca.server.outfits.OutfitServerStore;
+import net.minecraft.network.chat.Component;
+import net.minecraft.server.level.ServerPlayer;
+
+import java.io.Serial;
+
+/** A player sends an outfit texture to the server: it is stored for other players to see and, if wanted, kept in the player's library. */
+public class OutfitUploadMessage implements Message {
+    @Serial
+    private static final long serialVersionUID = 6310112304116001L;
+
+    private final String name;
+    private final int contentId;
+    private final byte[] png;
+    private final boolean library;
+
+    public OutfitUploadMessage(String name, int contentId, byte[] png, boolean library) {
+        this.name = name;
+        this.contentId = contentId;
+        this.png = png;
+        this.library = library;
+    }
+
+    @Override
+    public void receive(ServerPlayer player) {
+        String hash = OutfitServerStore.storeTexture(player.server, png);
+        if (hash == null) {
+            player.displayClientMessage(Component.literal("The server did not accept the outfit texture \"" + name + "\" (it must be a PNG under 28 KB, at most 128x128)."), true);
+        }
+        if (hash != null && library) {
+            String clean = name == null ? "" : name.substring(0, Math.min(name.length(), 60));
+            OutfitServerStore.addToLibrary(player.server, player.getUUID(), hash, clean, contentId);
+        }
+    }
+}
