diff --git a/common/src/main/java/net/conczin/mca/entity/ai/PoolFinder.java b/common/src/main/java/net/conczin/mca/entity/ai/PoolFinder.java
new file mode 100644
index 000000000..d03084589
--- /dev/null
+++ b/common/src/main/java/net/conczin/mca/entity/ai/PoolFinder.java
@@ -0,0 +1,255 @@
+package net.conczin.mca.entity.ai;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.tags.BlockTags;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.material.Fluids;
+
+import java.util.*;
+
+/**
+ * Finds swimming pools that were made by a player, and not lakes, rivers or the sea.
+ * <p>
+ * A body of water counts as a pool when
+ * <ul>
+ *   <li>it is a closed body of water (the top layer of source blocks is enough, the flowing water under it counts as well): not bigger than MAX_WATER blocks (that rules out the sea and big lakes),</li>
+ *   <li>it has an open top, at least MIN_SURFACE blocks of surface and is at least 2 blocks deep somewhere, and</li>
+ *   <li>it looks built: either at least half of the blocks around it are not natural (planks, bricks, concrete, glass, ...),
+ *   or its surface is a clean rectangle, which nature practically never makes (a pool dug into plain dirt).</li>
+ * </ul>
+ */
+public final class PoolFinder {
+    public static final int RADIUS = 50;
+    private static final int HEIGHT = 20;
+    /** Looking through this much water and air is slow, so the answer for a bed is kept for a while. */
+    private static final long CACHE_TICKS = 1200;
+    private static final Map<Long, Object[]> CACHE = new HashMap<>();
+    private static final int MAX_WATER = 6000;
+    private static final int MIN_SURFACE = 6;
+    private static final int MAX_OVERFLOWS = 3;
+
+    public record Pool(List<BlockPos> surface, int depth) {
+    }
+
+    private PoolFinder() {
+    }
+
+    /** Same as find, but villagers asking around the same bed within a minute share one search. */
+    @SuppressWarnings("unchecked")
+    public static synchronized List<Pool> findCached(ServerLevel level, BlockPos origin) {
+        long now = level.getGameTime();
+        long key = origin.asLong() ^ ((long) level.dimension().location().hashCode() << 40);
+        Object[] cached = CACHE.get(key);
+        if (cached != null && now - (Long) cached[0] < CACHE_TICKS) {
+            return (List<Pool>) cached[1];
+        }
+        List<Pool> pools = find(level, origin);
+        CACHE.put(key, new Object[]{now, pools});
+        if (CACHE.size() > 64) {
+            CACHE.values().removeIf(entry -> now - (Long) entry[0] >= CACHE_TICKS);
+        }
+        return pools;
+    }
+
+    /** All pools with water within RADIUS blocks of origin, the closest first. */
+    public static List<Pool> find(ServerLevel level, BlockPos origin) {
+        return scan(level, origin, null);
+    }
+
+    /** Explains, for every body of water near origin, why it is or is not a pool (for the debug pool button). */
+    public static List<String> diagnose(ServerLevel level, BlockPos origin) {
+        List<String> report = new ArrayList<>();
+        scan(level, origin, report);
+        return report;
+    }
+
+    private static List<Pool> scan(ServerLevel level, BlockPos origin, List<String> report) {
+        Set<Long> visited = new HashSet<>();
+        List<Pool> pools = new ArrayList<>();
+        int overflows = 0;
+        BlockPos.MutableBlockPos pos = new BlockPos.MutableBlockPos();
+
+        for (int x = -RADIUS; x <= RADIUS; x++) {
+            for (int z = -RADIUS; z <= RADIUS; z++) {
+                pos.set(origin.getX() + x, origin.getY(), origin.getZ() + z);
+                if (!level.hasChunkAt(pos)) {
+                    continue;
+                }
+                for (int y = -HEIGHT; y <= HEIGHT; y++) {
+                    pos.set(origin.getX() + x, origin.getY() + y, origin.getZ() + z);
+                    if (visited.contains(pos.asLong()) || !isSourceWater(level, pos)) {
+                        continue;
+                    }
+                    Set<BlockPos> water = flood(level, pos.immutable(), visited);
+                    if (water == null) {
+                        if (report != null) {
+                            report.add("Water at " + pos.getX() + " " + pos.getY() + " " + pos.getZ() + ": bigger than " + MAX_WATER + " blocks (sea or a big lake), ignored.");
+                        }
+                        if (++overflows >= MAX_OVERFLOWS) {
+                            return sorted(pools, origin);
+                        }
+                        continue;
+                    }
+                    Pool pool = judge(level, water, report, origin);
+                    if (pool != null) {
+                        pools.add(pool);
+                    }
+                }
+            }
+        }
+        return sorted(pools, origin);
+    }
+
+    private static List<Pool> sorted(List<Pool> pools, BlockPos origin) {
+        pools.sort(Comparator.comparingDouble(p -> p.surface().stream().mapToDouble(b -> b.distSqr(origin)).min().orElse(Double.MAX_VALUE)));
+        return pools;
+    }
+
+    private static boolean isSourceWater(ServerLevel level, BlockPos pos) {
+        // flowing water counts too: a pool only needs source blocks on top, the water below it falls down as flowing water
+        return level.getFluidState(pos).is(net.minecraft.tags.FluidTags.WATER);
+    }
+
+    /** The connected water (source and flowing), or null when it is too big to be a pool. */
+    private static Set<BlockPos> flood(ServerLevel level, BlockPos start, Set<Long> visited) {
+        Set<BlockPos> water = new HashSet<>();
+        Deque<BlockPos> queue = new ArrayDeque<>();
+        queue.add(start);
+        visited.add(start.asLong());
+        boolean tooBig = false;
+        while (!queue.isEmpty()) {
+            BlockPos current = queue.poll();
+            water.add(current);
+            if (water.size() > MAX_WATER) {
+                tooBig = true;
+                break;
+            }
+            for (Direction direction : Direction.values()) {
+                BlockPos next = current.relative(direction);
+                if (!visited.contains(next.asLong()) && level.hasChunkAt(next) && isSourceWater(level, next)) {
+                    visited.add(next.asLong());
+                    queue.add(next);
+                }
+            }
+        }
+        return tooBig ? null : water;
+    }
+
+    private static Pool judge(ServerLevel level, Set<BlockPos> water, List<String> report, BlockPos origin) {
+        List<BlockPos> surface = new ArrayList<>();
+        int roofed = 0;
+        int depth = 1;
+        for (BlockPos pos : water) {
+            BlockPos above = pos.above();
+            if (!water.contains(above)) {
+                if (!level.getBlockState(above).getCollisionShape(level, above).isEmpty() || !level.getFluidState(above).isEmpty()) {
+                    roofed++; // a roof or something else on top of the water
+                    continue;
+                }
+                surface.add(pos);
+                int d = 1;
+                while (water.contains(pos.below(d))) {
+                    d++;
+                }
+                depth = Math.max(depth, d);
+            }
+        }
+        BlockPos closest = null;
+        int minX = Integer.MAX_VALUE, maxX = Integer.MIN_VALUE, minY = Integer.MAX_VALUE, maxY = Integer.MIN_VALUE, minZ = Integer.MAX_VALUE, maxZ = Integer.MIN_VALUE;
+        for (BlockPos pos : water) {
+            if (closest == null || pos.distSqr(origin) < closest.distSqr(origin)) {
+                closest = pos;
+            }
+            minX = Math.min(minX, pos.getX());
+            maxX = Math.max(maxX, pos.getX());
+            minY = Math.min(minY, pos.getY());
+            maxY = Math.max(maxY, pos.getY());
+            minZ = Math.min(minZ, pos.getZ());
+            maxZ = Math.max(maxZ, pos.getZ());
+        }
+        String name = "Water body of " + water.size() + " water blocks, " + (maxX - minX + 1) + " x " + (maxY - minY + 1) + " x " + (maxZ - minZ + 1)
+                + " (east-west x up-down x north-south); closest block " + closest.getX() + " " + closest.getY() + " " + closest.getZ()
+                + ", " + Math.round(Math.sqrt(closest.distSqr(origin))) + " blocks from the bed";
+        if (surface.size() < MIN_SURFACE) {
+            if (report != null) {
+                report.add(name + ": only " + surface.size() + " open surface blocks (needs " + MIN_SURFACE + "+)" + (roofed > 0 ? ", " + roofed + " have something above them (a roof?)" : "") + ".");
+            }
+            return null;
+        }
+        if (depth < 2) {
+            if (report != null) {
+                report.add(name + ": only 1 block deep (needs 2+ somewhere).");
+            }
+            return null;
+        }
+        float built = builtRatio(level, water);
+        float fill = rectangleFill(surface);
+        if (built >= 0.5F || fill >= 0.9F) {
+            if (report != null) {
+                report.add(name + ": POOL. " + surface.size() + " surface blocks, " + depth + " deep, " + Math.round(built * 100) + "% of the surrounding blocks are non-natural, rectangle fill " + Math.round(fill * 100) + "%.");
+            }
+            return new Pool(surface, depth);
+        }
+        if (report != null) {
+            report.add(name + ": looks natural. Only " + Math.round(built * 100) + "% of the surrounding blocks are non-natural (needs 50%+) and the top is " + Math.round(fill * 100) + "% of a filled rectangle (needs 90%+).");
+        }
+        return null;
+    }
+
+    /** The share of the blocks around the water that are not natural (planks, bricks, concrete, glass, ...). */
+    private static float builtRatio(ServerLevel level, Set<BlockPos> water) {
+        int total = 0;
+        int artificial = 0;
+        for (BlockPos pos : water) {
+            for (Direction direction : Direction.values()) {
+                BlockPos next = pos.relative(direction);
+                if (water.contains(next)) {
+                    continue;
+                }
+                BlockState state = level.getBlockState(next);
+                if (state.isAir() || !level.getFluidState(next).isEmpty()) {
+                    continue;
+                }
+                total++;
+                if (!isNatural(state)) {
+                    artificial++;
+                }
+            }
+        }
+        return total == 0 ? 0 : (float) artificial / total;
+    }
+
+    /** How much of its bounding rectangle the highest layer of water fills (0 when it is smaller than 3 x 3). */
+    private static float rectangleFill(List<BlockPos> surface) {
+        int top = surface.stream().mapToInt(BlockPos::getY).max().orElse(0);
+        int minX = Integer.MAX_VALUE, maxX = Integer.MIN_VALUE, minZ = Integer.MAX_VALUE, maxZ = Integer.MIN_VALUE, count = 0;
+        for (BlockPos pos : surface) {
+            if (pos.getY() != top) {
+                continue;
+            }
+            count++;
+            minX = Math.min(minX, pos.getX());
+            maxX = Math.max(maxX, pos.getX());
+            minZ = Math.min(minZ, pos.getZ());
+            maxZ = Math.max(maxZ, pos.getZ());
+        }
+        int width = maxX - minX + 1;
+        int length = maxZ - minZ + 1;
+        if (count < 9 || width < 3 || length < 3) {
+            return 0;
+        }
+        return (float) count / (width * length);
+    }
+
+    private static boolean isNatural(BlockState state) {
+        return state.is(BlockTags.DIRT) || state.is(BlockTags.SAND) || state.is(BlockTags.BASE_STONE_OVERWORLD)
+                || state.is(BlockTags.LEAVES) || state.is(BlockTags.ICE) || state.is(BlockTags.SNOW) || state.is(BlockTags.TERRACOTTA)
