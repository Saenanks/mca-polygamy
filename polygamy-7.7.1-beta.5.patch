+    private static void reloadIfChanged() {
+        long stamp = FILE.exists() ? FILE.lastModified() : -1;
+        if (stamp == loadedStamp) {
+            return;
+        }
+        loadedStamp = stamp;
+
+        if (stamp == -1) {
+            lines = defaults();
+            try {
+                File parent = FILE.getParentFile();
+                if (parent != null) {
+                    parent.mkdirs();
+                }
+                try (Writer writer = Files.newBufferedWriter(FILE.toPath(), StandardCharsets.UTF_8)) {
+                    GSON.toJson(lines, writer);
+                }
+                loadedStamp = FILE.lastModified();
+            } catch (IOException e) {
+                MCA.LOGGER.warn("Could not write {}", FILE, e);
+            }
+            return;
+        }
+
+        try (Reader reader = Files.newBufferedReader(FILE.toPath(), StandardCharsets.UTF_8)) {
+            Map<String, List<String>> loaded = GSON.fromJson(reader, new TypeToken<Map<String, List<String>>>() {
+            }.getType());
+            Map<String, List<String>> result = new LinkedHashMap<>();
+            if (loaded != null) {
+                loaded.forEach((key, value) -> {
+                    List<String> cleaned = new ArrayList<>();
+                    if (value != null) {
+                        for (String line : value) {
+                            if (line != null && !line.isBlank()) {
+                                cleaned.add(line);
+                            }
+                        }
+                    }
+                    result.put(key, cleaned);
+                });
+            }
+            if (!result.containsKey(VERSION_KEY) || !result.get(VERSION_KEY).contains(CURRENT_VERSION)) {
+                // an older file: add the newer lines once, so they can still be removed or edited afterwards
+                if (!result.containsKey("welcome")) {
+                    result.put("welcome", new ArrayList<>(defaults().get("welcome")));
+                }
+                addedLines().forEach((key, value) -> {
+                    List<String> existing = result.computeIfAbsent(key, k -> new ArrayList<>());
+                    for (String line : value) {
+                        if (!existing.contains(line)) {
+                            existing.add(line);
+                        }
+                    }
+                });
+                result.put(VERSION_KEY, List.of(CURRENT_VERSION));
+                try (Writer writer = Files.newBufferedWriter(FILE.toPath(), StandardCharsets.UTF_8)) {
+                    GSON.toJson(result, writer);
+                    loadedStamp = FILE.lastModified();
+                } catch (IOException e) {
+                    MCA.LOGGER.warn("Could not update {}", FILE, e);
+                }
+            }
+            lines = result;
+        } catch (Exception e) {
+            MCA.LOGGER.warn("Could not read {}, using the built-in lines instead", FILE, e);
+            lines = defaults();
+        }
+    }
