diff --git a/common/src/main/java/net/conczin/mca/client/model/BreastFaces.java b/common/src/main/java/net/conczin/mca/client/model/BreastFaces.java
new file mode 100644
index 000000000..65c1222d5
--- /dev/null
+++ b/common/src/main/java/net/conczin/mca/client/model/BreastFaces.java
@@ -0,0 +1,181 @@
+package net.conczin.mca.client.model;
+
+import net.conczin.mca.MCA;
+import net.minecraft.client.model.geom.ModelPart;
+import net.minecraft.core.Direction;
+import org.joml.Vector3f;
+
+import java.lang.reflect.Array;
+import java.lang.reflect.Field;
+import java.lang.reflect.Modifier;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Set;
+import java.util.WeakHashMap;
+
+/**
+ * Removes the faces of the breast cubes that point at the other breast, so clothing, hair and armor layers have nothing
+ * drawn on the insides of the breasts. The skin layer keeps all its faces.
+ * <p>
+ * The game offers no way to leave a face out of a cube once it is built, so this removes the face from the baked
+ * cubes: from the polygon list of the plain game, and from the face mask of Embeddium's copy of the cube. The fields are found by their type and not by their name, because the names differ between development and
+ * the running game. If anything does not look as expected nothing is changed.
+ */
+public final class BreastFaces {
+    private static final Set<ModelPart> DONE = Collections.synchronizedSet(Collections.newSetFromMap(new WeakHashMap<>()));
+    private static boolean warned;
+
+    private BreastFaces() {
+    }
+
+    /** Strips the inner faces of the left and right breast of the given breasts part. Doing it twice for a part does nothing. */
+    public static void stripInnerFaces(ModelPart breasts) {
+        if (breasts == null || !DONE.add(breasts)) {
+            return;
+        }
+        try {
+            // left breast: the face towards the middle points to +x, right breast: to -x
+            strip(breasts, "left", 1);
+            strip(breasts, "right", -1);
+        } catch (Throwable t) {
+            if (!warned) {
+                warned = true;
+                MCA.LOGGER.warn("Breast layers: could not remove the inner faces ({}), they will stay as they are", t.toString(), t);
+            }
+        }
+    }
+
+    private static void strip(ModelPart breasts, String side, int innerSign) throws ReflectiveOperationException {
+        if (!breasts.hasChild(side)) {
+            return;
+        }
+        ModelPart part = breasts.getChild(side);
+        Field cubesField = findField(ModelPart.class, List.class, null);
+        List<?> cubes = (List<?>) cubesField.get(part);
+        int removed = 0;
+        for (Object cube : cubes) {
+            removed += stripPolygons(cube, innerSign);
+            removed += stripCuboidFaces(cube, innerSign);
+        }
+        if (removed == 0) {
+            throw new IllegalStateException("no inner face found on the " + side + " breast");
+        }
+    }
+
+    /**
+     * Embeddium (and Sodium) draw model cubes from their own copy of the cube, which has a bit mask of the faces to draw.
+     * Switching off the face that points at the other breast there removes it from what is drawn.
+     */
+    private static int stripCuboidFaces(Object cube, int innerSign) throws ReflectiveOperationException {
+        int removed = 0;
+        Set<Object> done = Collections.newSetFromMap(new IdentityHashMap<>());
+        for (Field field : cube.getClass().getDeclaredFields()) {
+            if (Modifier.isStatic(field.getModifiers()) || !field.getType().getName().endsWith("ModelCuboid")) {
+                continue;
+            }
+            field.setAccessible(true);
+            Object cuboid = field.get(cube);
+            if (cuboid == null || !done.add(cuboid)) {
+                continue;
+            }
+            for (Field mask : cuboid.getClass().getDeclaredFields()) {
+                if (!Modifier.isStatic(mask.getModifiers()) && mask.getType() == int.class) {
+                    mask.setAccessible(true);
+                    int faces = mask.getInt(cuboid);
+                    // in the model's own coordinates the face at the largest x is the one the game calls WEST (index 4, drawn from x2),
+                    // and the face at the smallest x is called EAST (index 5, drawn from x1)
+                    int bit = 1 << (innerSign > 0 ? Direction.WEST.ordinal() : Direction.EAST.ordinal());
+                    if ((faces & bit) != 0) {
+                        mask.setInt(cuboid, faces & ~bit);
+                        removed++;
+                    }
+                }
+            }
+        }
+        return removed;
+    }
+
+    /** The plain game keeps the faces of a cube as a list of polygons, the ones on the inner side are removed from it. */
+    private static int stripPolygons(Object cube, int innerSign) {
+        try {
+            Field polygonsField = findArrayField(cube.getClass());
+            Object[] polygons = (Object[]) polygonsField.get(cube);
+            if (polygons.length == 0) {
+                return 0;
+            }
+
+            // the faces that lie flat on the side facing the other breast: all four corners at the extreme x
+            float extreme = -Float.MAX_VALUE;
+            for (Object polygon : polygons) {
+                for (Vector3f corner : corners(polygon)) {
+                    extreme = Math.max(extreme, corner.x() * innerSign);
+                }
+            }
+
+            List<Object> kept = new ArrayList<>();
+            int removed = 0;
+            for (Object polygon : polygons) {
+                boolean flatOnInnerSide = true;
+                for (Vector3f corner : corners(polygon)) {
+                    if (Math.abs(corner.x() * innerSign - extreme) > 1.0E-4F) {
+                        flatOnInnerSide = false;
+                    }
+                }
+                if (flatOnInnerSide) {
+                    removed++;
+                } else {
+                    kept.add(polygon);
+                }
+            }
+            if (removed == 0) {
+                return 0;
+            }
+            Object[] result = (Object[]) Array.newInstance(polygons.getClass().getComponentType(), kept.size());
+            for (int i = 0; i < result.length; i++) {
+                result[i] = kept.get(i);
+            }
+            polygonsField.set(cube, result);
+            return removed;
+        } catch (ReflectiveOperationException | RuntimeException e) {
+            return 0;
+        }
+    }
+
+    /** The corner positions of a polygon: the Vector3f fields of its vertices. */
+    private static List<Vector3f> corners(Object polygon) throws ReflectiveOperationException {
+        List<Vector3f> result = new ArrayList<>();
+        Field verticesField = findArrayField(polygon.getClass(), "Vertex");
+        for (Object vertex : (Object[]) verticesField.get(polygon)) {
+            Field posField = findField(vertex.getClass(), Vector3f.class, null);
+            result.add((Vector3f) posField.get(vertex));
+        }
+        return result;
+    }
+
+    private static Field findField(Class<?> owner, Class<?> type, Class<?> unused) throws NoSuchFieldException {
+        for (Field field : owner.getDeclaredFields()) {
+            if (!Modifier.isStatic(field.getModifiers()) && type.isAssignableFrom(field.getType())) {
+                field.setAccessible(true);
+                return field;
+            }
+        }
+        throw new NoSuchFieldException(owner.getName() + " has no field of type " + type.getName());
+    }
+
+    private static Field findArrayField(Class<?> owner) throws NoSuchFieldException {
+        return findArrayField(owner, "Polygon");
+    }
+
+    private static Field findArrayField(Class<?> owner, String componentName) throws NoSuchFieldException {
+        for (Field field : owner.getDeclaredFields()) {
+            if (!Modifier.isStatic(field.getModifiers()) && field.getType().isArray()
+                    && field.getType().getComponentType().getName().contains(componentName)) {
+                field.setAccessible(true);
+                return field;
+            }
+        }
+        throw new NoSuchFieldException(owner.getName() + " has no " + componentName + " array");
+    }
+}
diff --git a/common/src/main/java/net/conczin/mca/client/model/BreastPhysics.java b/common/src/main/java/net/conczin/mca/client/model/BreastPhysics.java
