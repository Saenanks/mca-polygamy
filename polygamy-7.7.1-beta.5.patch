+package net.conczin.mca.client.gui;
+
+import net.conczin.mca.client.OutfitStore;
+import net.conczin.mca.client.model.CommonVillagerModel;
+import net.conczin.mca.entity.EntitiesMCA;
+import net.conczin.mca.entity.VillagerEntityMCA;
+import net.conczin.mca.entity.VillagerLike;
+import net.conczin.mca.entity.ai.relationship.Gender;
+import net.conczin.mca.util.compat.ButtonWidget;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.GuiGraphics;
+import net.minecraft.client.gui.screens.Screen;
+import net.minecraft.client.gui.screens.inventory.InventoryScreen;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.network.chat.Component;
+import net.minecraft.resources.ResourceLocation;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Objects;
+import java.util.UUID;
+
+/**
+ * Lets the player choose which swimwear and sleepwear a villager uses.
+ * Opened from the villager interaction menu (button "Outfits", below "Family Tree").
+ */
+public class OutfitsScreen extends Screen {
+    private static final int COLUMNS = 6;
+    private static final int ROWS = 2;
+    private static final int PER_PAGE = COLUMNS * ROWS;
+
+    private final UUID villagerUuid;
+    private final Screen previous;
+    private final VillagerEntityMCA preview = Objects.requireNonNull(EntitiesMCA.MALE_VILLAGER.get().create(Objects.requireNonNull(Minecraft.getInstance().level)));
+    private final CompoundTag baseData = new CompoundTag();
+    private final Gender gender;
+    private final String genderKey;
+
+    private String kind = OutfitStore.SWIMWEAR;
+    private int page = 0;
+    private List<OutfitStore.Outfit> outfits = new ArrayList<>();
+
+    public OutfitsScreen(UUID villagerUuid, Screen previous) {
+        super(Component.translatable("gui.mca.outfits.title"));
+        this.villagerUuid = villagerUuid;
+        this.previous = previous;
+
+        VillagerLike<?> villager = CommonVillagerModel.getVillager(Minecraft.getInstance().level, villagerUuid);
+        if (villager instanceof VillagerEntityMCA v) {
+            v.addAdditionalSaveData(baseData);
+        }
+        preview.readAdditionalSaveData(baseData.copy());
+        this.gender = villager.getGenetics().getGender();
+        this.genderKey = gender.name().toLowerCase(Locale.ROOT);
+        reloadList();
+    }
+
+    private void reloadList() {
+        outfits = new ArrayList<>(OutfitStore.list(kind, genderKey));
+        int pages = Math.max(1, (outfits.size() + 1 + PER_PAGE - 1) / PER_PAGE);
+        page = Math.max(0, Math.min(page, pages - 1));
+    }
+
+    @Override
+    protected void init() {
+        super.init();
+        int cx = width / 2;
+
+        ButtonWidget swim = addRenderableWidget(new ButtonWidget(cx - 105, 12, 100, 20,
+                Component.translatable("gui.mca.outfits.swimwear"), b -> switchTab(OutfitStore.SWIMWEAR)));
+        swim.active = !kind.equals(OutfitStore.SWIMWEAR);
+        ButtonWidget sleep = addRenderableWidget(new ButtonWidget(cx + 5, 12, 100, 20,
+                Component.translatable("gui.mca.outfits.sleepwear"), b -> switchTab(OutfitStore.SLEEPWEAR)));
+        sleep.active = !kind.equals(OutfitStore.SLEEPWEAR);
+
+        int pages = Math.max(1, (outfits.size() + 1 + PER_PAGE - 1) / PER_PAGE);
+        int by = height - 28;
+        ButtonWidget prev = addRenderableWidget(new ButtonWidget(cx - 110, by, 30, 20, Component.literal("<<"), b -> {
+            page--;
+            rebuildWidgets();
+        }));
+        prev.active = page > 0;
+        ButtonWidget next = addRenderableWidget(new ButtonWidget(cx + 80, by, 30, 20, Component.literal(">>"), b -> {
+            page++;
+            rebuildWidgets();
+        }));
+        next.active = page < pages - 1;
+        addRenderableWidget(new ButtonWidget(cx - 40, by, 80, 20, Component.translatable("gui.mca.outfits.done"), b -> onClose()));
+    }
+
+    private void switchTab(String newKind) {
+        kind = newKind;
+        page = 0;
+        reloadList();
+        rebuildWidgets();
+    }
+
+    @Override
+    public void onClose() {
+        Minecraft.getInstance().setScreen(previous);
+    }
+
+    /** Tile 0 on the first page is always "normal clothes". Returns null for tile 0, otherwise the outfit. */
+    private OutfitStore.Outfit outfitAt(int tile) {
+        int index = page * PER_PAGE + tile;
+        if (index == 0) return null;
+        return outfits.get(index - 1);
+    }
+
+    private boolean tileExists(int tile) {
+        int index = page * PER_PAGE + tile;
+        return index <= outfits.size();
+    }
+
+    private int tileX(int tile) {
+        int col = tile % COLUMNS;
+        return width / 2 + (int) ((col - COLUMNS / 2.0 + 0.5) * 58);
+    }
+
+    private int tileY(int tile) {
+        int row = tile / COLUMNS;
+        return 50 + 70 + row * 100;
+    }
+
+    private String chosenId() {
+        String c = OutfitStore.getChoice(villagerUuid, kind);
+        return c;
+    }
+
+    private boolean isSelected(int tile) {
+        String c = chosenId();
+        int index = page * PER_PAGE + tile;
+        if (index == 0) {
+            return OutfitStore.NONE.equals(c);
+        }
+        return c != null && c.equals(outfits.get(index - 1).id());
+    }
+
+    @Override
+    public void render(GuiGraphics context, int mouseX, int mouseY, float delta) {
+        renderBackground(context);
+
+        context.drawCenteredString(font, Component.translatable("gui.mca.outfits.help." + kind), width / 2, 38, 0xFFCCCCCC);
+
+        preview.setAge(0);
+        preview.getGenetics().setGender(gender.binary());
+        Component tooltip = null;
+
+        for (int tile = 0; tile < PER_PAGE; tile++) {
+            if (!tileExists(tile)) break;
+            int cx = tileX(tile);
+            int cy = tileY(tile);
+            OutfitStore.Outfit outfit = outfitAt(tile);
+
+            boolean hovered = Math.abs(cx - mouseX) <= 28 && mouseY >= cy - 62 && mouseY <= cy + 6;
+            if (isSelected(tile)) {
+                context.fill(cx - 28, cy - 66, cx + 28, cy + 8, 0x6655FF55);
+            } else if (hovered) {
+                context.fill(cx - 28, cy - 66, cx + 28, cy + 8, 0x33FFFFFF);
+            }
+            if (hovered) {
+                tooltip = outfit == null ? Component.translatable("gui.mca.outfits.normal") : Component.literal(outfit.label());
+            }
+
+            preview.readAdditionalSaveData(baseData.copy());
+            preview.setAge(0);
+            preview.getGenetics().setGender(gender.binary());
+            if (outfit != null) {
+                preview.setClothes(outfit.texture());
+            }
+            InventoryScreen.renderEntityInInventoryFollowsMouse(context, cx, cy, hovered ? 32 : 30,
+                    -(mouseX - cx) / 2.0f, -(mouseY - cy + 30) / 2.0f, preview);
+        }
+
+        if (outfits.isEmpty()) {
+            context.drawCenteredString(font, Component.translatable("gui.mca.outfits.empty"), width / 2, height / 2 + 40, 0xFFFFAA55);
+        }
+
+        context.drawCenteredString(font, Component.translatable("gui.mca.outfits.footer"), width / 2, height - 42, 0xFF999999);
+
+        super.render(context, mouseX, mouseY, delta);
+
+        if (tooltip != null) {
+            context.renderTooltip(font, tooltip, mouseX, mouseY);
+        }
+    }
+
+    @Override
+    public boolean mouseClicked(double mouseX, double mouseY, int button) {
+        if (super.mouseClicked(mouseX, mouseY, button)) {
+            return true;
+        }
+        for (int tile = 0; tile < PER_PAGE; tile++) {
+            if (!tileExists(tile)) break;
+            int cx = tileX(tile);
+            int cy = tileY(tile);
+            if (Math.abs(cx - mouseX) <= 28 && mouseY >= cy - 62 && mouseY <= cy + 6) {
+                OutfitStore.Outfit outfit = outfitAt(tile);
+                if (outfit == null) {
+                    OutfitStore.setChoice(villagerUuid, kind, OutfitStore.NONE);
+                } else if (button == 1 || outfit.id().equals(chosenId())) {
+                    // right click, or click on the selected one again, goes back to automatic
+                    OutfitStore.setChoice(villagerUuid, kind, null);
+                } else {
+                    OutfitStore.setChoice(villagerUuid, kind, outfit.id());
+                }
+                return true;
+            }
+        }
+        return false;
+    }
+}
