+++ b/common/src/main/java/net/conczin/mca/client/OutfitStore.java
@@ -0,0 +1,437 @@
+package net.conczin.mca.client;
+
+import com.google.gson.Gson;
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.mojang.blaze3d.platform.NativeImage;
+import net.conczin.mca.MCA;
+import net.conczin.mca.cobalt.network.NetworkHandler;
+import net.conczin.mca.network.c2s.OutfitDeleteMessage;
+import net.conczin.mca.network.c2s.OutfitListMessage;
+import net.conczin.mca.network.c2s.OutfitRequestMessage;
+import net.conczin.mca.network.c2s.OutfitSyncRequest;
+import net.conczin.mca.network.c2s.OutfitUploadMessage;
+import net.conczin.mca.network.c2s.VillagerOutfitMessage;
+import net.conczin.mca.server.outfits.OutfitServerStore;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.renderer.texture.DynamicTexture;
+import net.minecraft.resources.ResourceLocation;
+import org.apache.commons.io.FileUtils;
+
+import java.io.ByteArrayInputStream;
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.*;
+
+/**
+ * Client side store for the outfits menu.
+ * <ul>
+ *   <li>Saved outfits live in {@code ./mca_outfits/saved/*.png} (saved from the player made skin library, or drop your own 64x64 PNGs in).</li>
+ *   <li>{@code ./mca_outfits/saved.json} remembers each outfit's name and library id, {@code lists.json} which saved outfits are in the
+ *   swimwear and sleepwear tabs.</li>
+ *   <li>Outfits are also kept on the server (the player's library, and the textures villagers wear), so other players see them and
+ *   a lost folder is restored from the server when the outfits menu is opened.</li>
+ *   <li>The outfit a villager wears is stored on the villager (as the hash of the texture), so everybody sees the same.</li>
+ *   <li>{@code ./mca_outfits/cache/} holds textures of other players' outfits received from the server.</li>
+ * </ul>
+ */
+public final class OutfitStore {
+    public static final String SLEEPWEAR = "sleepwear";
+    public static final String SWIMWEAR = "swimwear";
+
+    private static final File DIR = new File("./mca_outfits");
+    private static final File SAVED_DIR = new File(DIR, "saved");
+    private static final File CACHE_DIR = new File(DIR, "cache");
+    private static final Gson GSON = new Gson();
+    private static final long REQUEST_RETRY_MILLIS = 20000;
+
+    /** @param id file name inside the saved folder; @param contentId skin library id, or 0 if unknown; @param hash hash of the texture */
+    /** The outfits that come with the mod (its clothes list). They are stored on a villager as "mod:" + the clothes identifier. */
+    public static final String MOD = "mod";
+    public static final String MOD_PREFIX = "mod:";
+
+    public static boolean isModHash(String hash) {
+        return hash != null && hash.startsWith(MOD_PREFIX);
+    }
+
+    /** The mod's own outfits that fit this gender, as the villager editor lists them. */
+    public static synchronized List<Outfit> modOutfits(net.conczin.mca.entity.ai.relationship.Gender gender) {
+        List<Outfit> result = new ArrayList<>();
+        for (net.conczin.mca.resources.data.skin.Clothing clothing : net.conczin.mca.resources.SkinSelection.editorClothing(net.conczin.mca.client.resources.ClientSkinCatalog.clothing().values(), gender)) {
+            Outfit outfit = modOutfit(MOD_PREFIX + clothing.getIdentifier());
+            if (outfit != null) {
+                result.add(outfit);
+            }
+        }
+        return result;
+    }
+
+    /** The outfit for a "mod:..." value, or null if it is not a valid one. */
+    public static Outfit modOutfit(String hash) {
+        if (!isModHash(hash)) {
+            return null;
+        }
+        try {
+            String identifier = hash.substring(MOD_PREFIX.length());
+            ResourceLocation texture = new ResourceLocation(identifier);
+            String label = texture.getPath();
+            label = label.substring(label.lastIndexOf('/') + 1);
+            if (label.endsWith(".png")) {
+                label = label.substring(0, label.length() - 4);
+            }
+            return new Outfit(hash, label, texture, 0, hash);
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    public record Outfit(String id, String label, ResourceLocation texture, int contentId, String hash) {
+    }
+
+    private record FileInfo(long modified, byte[] bytes, String hash) {
+    }
+
+    private static final Map<String, ResourceLocation> TEXTURES = new HashMap<>();
+    private static final Map<String, FileInfo> FILES = new HashMap<>();
+    private static final Map<String, Long> REQUESTED = new HashMap<>();
+    private static Map<String, List<String>> lists;
+    private static JsonObject meta;
+    private static List<Outfit> cache;
+    private static long cacheTime = 0;
+
+    private OutfitStore() {
+    }
+
+    // ---- textures ----
+
+    private static ResourceLocation register(String hash, byte[] png) {
+        ResourceLocation location = new ResourceLocation("immersive_library", "outfits_user/h" + hash);
+        try (ByteArrayInputStream in = new ByteArrayInputStream(png)) {
+            NativeImage image = NativeImage.read(in);
+            // The namespace is what makes the renderer accept this dynamic texture.
+            Minecraft.getInstance().getTextureManager().register(location, new DynamicTexture(image));
+            TEXTURES.put(hash, location);
+            return location;
+        } catch (IOException | RuntimeException e) {
+            MCA.LOGGER.warn("Could not load outfit texture {}", hash, e);
+            return null;
+        }
+    }
+
+    /**
+     * The texture of an outfit a villager wears, or null if it is not available yet. If it is neither saved here nor cached,
+     * it is requested from the server and shows up a moment later.
+     */
+    public static synchronized ResourceLocation textureForHash(String hash) {
+        if (hash == null || hash.isEmpty()) {
+            return null;
+        }
+        if (isModHash(hash)) {
+            Outfit mod = modOutfit(hash);
+            return mod == null ? null : mod.texture();
+        }
+        ResourceLocation known = TEXTURES.get(hash);
+        if (known != null) {
+            return known;
+        }
+        for (Outfit o : listAll()) {
+            if (o.hash().equals(hash)) return o.texture();
+        }
+        File cached = new File(CACHE_DIR, hash + ".png");
+        if (cached.exists()) {
+            try {
+                byte[] bytes = FileUtils.readFileToByteArray(cached);
+                if (OutfitServerStore.hash(bytes).equals(hash)) {
+                    return register(hash, bytes);
+                }
+            } catch (IOException ignored) {
+            }
+        }
+        long now = System.currentTimeMillis();
+        Long last = REQUESTED.get(hash);
+        if ((last == null || now - last > REQUEST_RETRY_MILLIS) && OutfitServerStore.isValidHash(hash)) {
+            REQUESTED.put(hash, now);
+            NetworkHandler.sendToServer(new OutfitRequestMessage(hash));
+        }
+        return null;
+    }
+
+    /** The server sent the texture of an outfit. */
+    public static synchronized void receiveTexture(String hash, byte[] png) {
+        if (!OutfitServerStore.isValidHash(hash) || !OutfitServerStore.hash(png).equals(hash)) {
+            return;
+        }
+        try {
+            //noinspection ResultOfMethodCallIgnored
+            CACHE_DIR.mkdirs();
+            FileUtils.writeByteArrayToFile(new File(CACHE_DIR, hash + ".png"), png);
+        } catch (IOException e) {
+            MCA.LOGGER.warn("Could not cache outfit texture {}", hash, e);
+        }
+        register(hash, png);
+    }
+
+    // ---- saved outfits ----
+
+    public static synchronized List<Outfit> listAll() {
+        long now = System.currentTimeMillis();
+        if (cache != null && now - cacheTime < 3000) {
+            return cache;
+        }
+        List<Outfit> result = new ArrayList<>();
+        File[] files = SAVED_DIR.listFiles((d, n) -> n.toLowerCase(Locale.ROOT).endsWith(".png"));
+        if (files != null) {
+            Arrays.sort(files, Comparator.comparing(File::getName, String.CASE_INSENSITIVE_ORDER));
+            JsonObject m = meta();
+            for (File f : files) {
+                FileInfo info = FILES.get(f.getName());
+                if (info == null || info.modified() != f.lastModified()) {
+                    try {
+                        byte[] bytes = FileUtils.readFileToByteArray(f);
+                        info = new FileInfo(f.lastModified(), bytes, OutfitServerStore.hash(bytes));
+                        FILES.put(f.getName(), info);
+                    } catch (IOException e) {
+                        continue;
+                    }
+                }
+                ResourceLocation tex = TEXTURES.get(info.hash());
+                if (tex == null) tex = register(info.hash(), info.bytes());
+                if (tex == null) continue;
+
+                String label = f.getName().substring(0, f.getName().length() - 4);
+                int contentId = 0;
+                if (m.has(f.getName())) {
+                    JsonObject o = m.getAsJsonObject(f.getName());
+                    if (o.has("name")) label = o.get("name").getAsString();
+                    if (o.has("contentid")) contentId = o.get("contentid").getAsInt();
+                }
+                result.add(new Outfit(f.getName(), label, tex, contentId, info.hash()));
+            }
+        }
+        cache = result;
+        cacheTime = now;
+        return result;
+    }
+
+    /** The saved outfits that were added to the swimwear or sleepwear tab. */
+    public static synchronized List<Outfit> list(String kind) {
+        List<String> ids = lists().getOrDefault(kind, List.of());
+        List<Outfit> result = new ArrayList<>();
+        for (Outfit o : listAll()) {
+            if (ids.contains(o.id())) result.add(o);
+        }
+        return result;
+    }
+
+    public static synchronized boolean isInList(String kind, String id) {
+        return lists().getOrDefault(kind, List.of()).contains(id);
+    }
+
+    public static synchronized void addToList(String kind, String id) {
+        List<String> l = lists().computeIfAbsent(kind, k -> new ArrayList<>());
+        if (!l.contains(id)) l.add(id);
+        writeJson("lists.json", lists());
+        pushList(kind);
+    }
+
+    public static synchronized void removeFromList(String kind, String id) {
+        List<String> l = lists().get(kind);
+        if (l != null) l.remove(id);
+        writeJson("lists.json", lists());
+        pushList(kind);
+    }
+
+    /** Tells the server what is in this tab (as texture hashes) so it is kept there too. */
+    private static void pushList(String kind) {
+        ArrayList<String> hashes = new ArrayList<>();
+        List<String> ids = lists().getOrDefault(kind, List.of());
+        for (Outfit o : listAll()) {
+            if (ids.contains(o.id())) hashes.add(o.hash());
+        }
+        NetworkHandler.sendToServer(new OutfitListMessage(kind, hashes));
+    }
+
+    public static synchronized void delete(Outfit outfit) {
+        //noinspection ResultOfMethodCallIgnored
+        new File(SAVED_DIR, outfit.id()).delete();
+        FILES.remove(outfit.id());
+        for (List<String> l : lists().values()) l.remove(outfit.id());
+        writeJson("lists.json", lists());
+        pushList(SWIMWEAR);
+        pushList(SLEEPWEAR);
+        meta().remove(outfit.id());
+        writeJson("saved.json", meta());
+        cache = null;
+        NetworkHandler.sendToServer(new OutfitDeleteMessage(outfit.hash()));
+    }
+
+    /** Saves a skin from the library as an outfit, named like the library entry, and keeps a copy on the server. Returns the display name. */
+    public static synchronized String save(String name, int contentId, NativeImage image) throws IOException {
+        String clean = name == null ? "" : name.replaceAll("[\\\\/:*?\"<>|]", "").trim();
+        if (clean.isEmpty()) clean = "outfit " + contentId;
+        if (clean.length() > 40) clean = clean.substring(0, 40).trim();
+        byte[] png = image.asByteArray();
+        writeSaved(clean, contentId, png);
+        NetworkHandler.sendToServer(new OutfitUploadMessage(clean, contentId, png, true));
+        return clean;
+    }
+
+    private static void writeSaved(String clean, int contentId, byte[] png) throws IOException {
+        //noinspection ResultOfMethodCallIgnored
+        SAVED_DIR.mkdirs();
+        // the same library skin saved twice replaces the old copy, a different skin with the same name gets its id added
+        String fileName = clean + ".png";
+        JsonObject m = meta();
+        boolean taken = new File(SAVED_DIR, fileName).exists();
+        boolean sameSkin = m.has(fileName) && m.getAsJsonObject(fileName).has("contentid")
+                && m.getAsJsonObject(fileName).get("contentid").getAsInt() == contentId;
+        if (taken && !sameSkin) {
+            fileName = clean + " (" + contentId + ").png";
+        }
+        FileUtils.writeByteArrayToFile(new File(SAVED_DIR, fileName), png);
+
+        JsonObject o = new JsonObject();
+        o.addProperty("name", clean);
+        o.addProperty("contentid", contentId);
+        m.add(fileName, o);
+        writeJson("saved.json", m);
+        cache = null;
+        FILES.remove(fileName);
+    }
+
+    // ---- server sync ----
+
+    /** Called when the outfits menu opens: asks the server for outfits we lost and tells it what we have. */
+    public static synchronized void sync() {
+        ArrayList<String> hashes = new ArrayList<>();
+        for (Outfit o : listAll()) hashes.add(o.hash());
+        NetworkHandler.sendToServer(new OutfitSyncRequest(hashes));
+    }
+
+    /** An outfit from the library on the server that is missing here: put it back. */
+    public static synchronized void restore(String name, int contentId, byte[] png) {
+        String hash = OutfitServerStore.hash(png);
+        for (Outfit o : listAll()) {
+            if (o.hash().equals(hash)) return;
+        }
+        try {
+            writeSaved(name == null || name.isBlank() ? "outfit " + contentId : name, contentId, png);
+        } catch (IOException e) {
+            MCA.LOGGER.warn("Could not restore outfit {}", name, e);
+        }
+    }
+
+    /**
+     * The server told us what it has: upload the saved outfits it does not have yet, add what it has in the swimwear and sleepwear
+     * tabs to ours, and send our tabs back so both sides match.
+     */
+    public static synchronized void onSyncResponse(List<String> serverHashes, List<String> swimwear, List<String> sleepwear) {
+        for (Outfit o : listAll()) {
+            if (!serverHashes.contains(o.hash())) {
+                FileInfo info = FILES.get(o.id());
+                if (info != null && info.bytes().length <= OutfitServerStore.MAX_BYTES) {
+                    NetworkHandler.sendToServer(new OutfitUploadMessage(o.label(), o.contentId(), info.bytes(), true));
+                }
+            }
+        }
+        boolean changed = false;
+        for (Outfit o : listAll()) {
+            if (swimwear.contains(o.hash()) && !lists().computeIfAbsent(SWIMWEAR, k -> new ArrayList<>()).contains(o.id())) {
+                lists().get(SWIMWEAR).add(o.id());
+                changed = true;
+            }
+            if (sleepwear.contains(o.hash()) && !lists().computeIfAbsent(SLEEPWEAR, k -> new ArrayList<>()).contains(o.id())) {
+                lists().get(SLEEPWEAR).add(o.id());
+                changed = true;
+            }
+        }
+        if (changed) {
+            writeJson("lists.json", lists());
+        }
+        pushList(SWIMWEAR);
+        pushList(SLEEPWEAR);
+    }
+
+    /** Chooses the outfit (or null for normal clothes) of a villager. The server keeps it on the villager so everybody sees it. */
+    public static synchronized void choose(UUID villager, String kind, Outfit outfit) {
+        if (outfit != null) {
+            FileInfo info = FILES.get(outfit.id());
+            if (info != null && info.bytes().length <= OutfitServerStore.MAX_BYTES) {
+                // makes sure the server has the texture (it is a no-op if it already has it)
+                NetworkHandler.sendToServer(new OutfitUploadMessage(outfit.label(), outfit.contentId(), info.bytes(), false));
+            }
+        }
+        NetworkHandler.sendToServer(new VillagerOutfitMessage(villager, kind, outfit == null ? "" : outfit.hash()));
+    }
+
+    /**
+     * Older versions kept the choice per villager on this computer (assignments.json). If this villager has no outfit on the
+     * server yet but has an old choice that still exists here, send it to the server now.
+     */
+    public static synchronized void migrateLegacy(UUID villager, net.conczin.mca.entity.VillagerLike<?> entity) {
+        JsonObject root = readJson("assignments.json");
+        if (!root.has(villager.toString())) {
+            return;
+        }
+        JsonObject old = root.getAsJsonObject(villager.toString());
+        for (String kind : new String[]{SLEEPWEAR, SWIMWEAR}) {
+            String current = SLEEPWEAR.equals(kind) ? entity.getSleepwearOutfit() : entity.getSwimwearOutfit();
+            if (!current.isEmpty() || !old.has(kind)) {
+                continue;
+            }
+            String id = old.get(kind).getAsString();
+            for (Outfit o : listAll()) {
+                if (o.id().equals(id)) {
+                    choose(villager, kind, o);
+                    break;
+                }
+            }
+        }
+    }
+
+    // ---- json helpers ----
+
+    private static JsonObject readJson(String name) {
+        File file = new File(DIR, name);
+        if (file.exists()) {
+            try {
+                return JsonParser.parseString(FileUtils.readFileToString(file, StandardCharsets.UTF_8)).getAsJsonObject();
+            } catch (Exception e) {
+                MCA.LOGGER.warn("Could not read {}", name, e);
+            }
+        }
+        return new JsonObject();
+    }
+
+    private static void writeJson(String name, Object data) {
+        try {
+            //noinspection ResultOfMethodCallIgnored
+            DIR.mkdirs();
+            FileUtils.writeStringToFile(new File(DIR, name), GSON.toJson(data), StandardCharsets.UTF_8);
+        } catch (IOException e) {
+            MCA.LOGGER.warn("Could not save {}", name, e);
+        }
+    }
+
+    private static JsonObject meta() {
+        if (meta == null) meta = readJson("saved.json");
+        return meta;
+    }
+
+    private static Map<String, List<String>> lists() {
+        if (lists == null) {
+            lists = new HashMap<>();
+            JsonObject root = readJson("lists.json");
+            for (String kind : root.keySet()) {
+                List<String> l = new ArrayList<>();
+                JsonArray a = root.getAsJsonArray(kind);
+                for (JsonElement e : a) l.add(e.getAsString());
+                lists.put(kind, l);
+            }
+        }
+        return lists;
+    }
+}
