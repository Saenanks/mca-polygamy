@@ -0,0 +1,70 @@
+package net.conczin.mca.client.model;
+
+import net.conczin.mca.entity.VillagerLike;
+import net.minecraft.util.Mth;
+import net.minecraft.world.entity.Entity;
+
+import java.util.Map;
+import java.util.WeakHashMap;
+
+/**
+ * Client side part of the bedtime show of a Deviant spouse (the server side is BedtimeSleepTask, which also turns her around).
+ * While she has her hands on her breasts the arms bob up and down and the breast spring is pushed with the very same
+ * rhythm, so they move together. When the hands go down the spring simply swings out on its own.
+ */
+public final class BedtimeAnimation {
+    public static final int TWIRL = 1;
+    public static final int HANDS_UP = 2;
+    public static final int HANDS_DOWN = 3;
+    public static final int REST = 4;
+
+    /** Bobs per second of the hands. She bobs exactly BOBS times (BedtimeSleepTask keeps the hands up for that long). */
+    private static final double RATE = 2.14;
+    private static final int BOBS = 3;
+    private static final float RAISE_TICKS = 8.0F;
+    private static final float LOWER_TICKS = 10.0F;
+
+    private static final Map<Entity, long[]> STATE = new WeakHashMap<>();
+
+    private BedtimeAnimation() {
+    }
+
+    public static int phase(Entity entity) {
+        return entity instanceof VillagerLike<?> villager ? villager.getBedtimeAnim() : 0;
+    }
+
+    private static long[] track(Entity entity, int phase) {
+        synchronized (STATE) {
+            long[] s = STATE.computeIfAbsent(entity, e -> new long[]{-1, 0, 0});
+            if (s[0] != phase) {
+                s[0] = phase;
+                s[1] = entity.tickCount;
+                s[2] = System.nanoTime();
+            }
+            return s.clone();
+        }
+    }
+
+    /** -1 to 1, the shared rhythm of hands and breasts: exactly three bobs after the hands go up, then still. */
+    public static float oscillation(Entity entity) {
+        if (phase(entity) != HANDS_UP) {
+            return 0;
+        }
+        double seconds = (System.nanoTime() - track(entity, HANDS_UP)[2]) / 1.0E9;
+        if (seconds * RATE >= BOBS) {
+            return 0;
+        }
+        return (float) Math.sin(seconds * 2 * Math.PI * RATE);
+    }
+
+    /** 0 = arms as usual, 1 = hands on the breasts. */
+    public static float armAmount(Entity entity, float partialTick) {
+        int phase = phase(entity);
+        if (phase != HANDS_UP && phase != HANDS_DOWN) {
+            return 0;
+        }
+        long start = track(entity, phase)[1];
+        float age = entity.tickCount - start + partialTick;
+        return phase == HANDS_UP ? Mth.clamp(age / RAISE_TICKS, 0, 1) : 1 - Mth.clamp(age / LOWER_TICKS, 0, 1);
+    }
+}
