+    public static boolean isDeviantSpouse(VillagerEntityMCA villager, ServerPlayer player) {
+        return villager.getRelationships().isMarriedTo(player.getUUID())
+                && Traits.DEVIANT.isEnabled()
+                && villager.getGenetics().getGender() == Gender.FEMALE
+                && DeviantLines.isAdult(villager.getAgeState())
+                && villager.getTraits().hasTrait(Traits.DEVIANT)
