+    }
+
+    @Override
+    protected boolean checkExtraStartConditions(ServerLevel level, VillagerEntityMCA villager) {
+        if (villager.swimRequester != null) {
+            return startRequested(level, villager);
+        }
+        long dayTime = level.getDayTime();
+        long day = dayTime / 24000L;
+        int timeOfDay = (int) (dayTime % 24000L);
+        if (day != planDay) {
+            planDay = day;
+            planDay(villager);
+        }
+        if (nextIndex >= starts.length || timeOfDay < starts[nextIndex]) {
+            return false;
+        }
+        if (dayTime < lastEnd + MIN_BREAK) {
+            // still resting after the last swim (the button counts too): the planned swim waits for the end of the break,
+            // even if that is after the usual 17:00
+            postponed = true;
+            return false;
+        }
+        if (timeOfDay > (postponed ? POSTPONED_LATEST_START : WINDOW_END)) {
+            nextIndex = starts.length;
+            return false;
+        }
+        if (!eligible(level, villager)) {
+            return false;
+        }
+        if (!findPool(level, villager, true)) {
+            // nowhere to swim near her bed: no more tries today
+            nextIndex = starts.length;
+            return false;
+        }
+        return true;
+    }
+
+    /** The button: swim now if there is a pool (otherwise say that there is none). */
+    private boolean startRequested(ServerLevel level, VillagerEntityMCA villager) {
+        ServerPlayer player = level.getServer().getPlayerList().getPlayer(villager.swimRequester);
+        villager.swimRequester = null;
+        if (player == null || phase != Phase.IDLE) {
+            return false;
+        }
+        var brain = villager.getBrain();
+        if (villager.getSwimwearOutfit().isEmpty() || villager.isBaby() || !DeviantLines.isAdult(villager.getAgeState())
+                || villager.isSleeping() || villager.isPassenger() || villager.isTrading()
+                || brain.isActive(Activity.PANIC) || brain.isActive(Activity.RAID) || brain.isActive(ActivityMCA.SWIM.get())) {
+            return false;
+        }
+        if (!findPool(level, villager, false)) {
+            String line = BedtimeLines.pickSwimNow(villager, player, false);
+            if (line != null) {
+                villager.sendChatMessage(Component.literal(line), player);
+            }
+            return false;
+        }
+        forced = true;
+        requester = player;
+        return true;
+    }
+
+    private void planDay(VillagerEntityMCA villager) {
+        var random = villager.getRandom();
+        int roll = random.nextInt(10);
+        nextIndex = 0;
+        postponed = false;
+        if (roll < 1) {
+            starts = new int[0];
+        } else if (roll < 6) {
+            starts = new int[]{WINDOW_START + random.nextInt(6501)};
+        } else {
+            int first = WINDOW_START + random.nextInt(3001);
+            int earliest = first + 3000;
+            starts = new int[]{first, earliest + random.nextInt(10000 - earliest + 1)};
+        }
+    }
+
+    private boolean eligible(ServerLevel level, VillagerEntityMCA villager) {
+        var brain = villager.getBrain();
+        boolean daytimeActivity = brain.isActive(Activity.IDLE) || brain.isActive(Activity.WORK) || brain.isActive(Activity.MEET);
+        return daytimeActivity
+                && !brain.isActive(Activity.PANIC) && !brain.isActive(Activity.RAID) && !brain.isActive(Activity.PRE_RAID) && !brain.isActive(Activity.HIDE)
+                && !brain.isActive(Activity.REST) && !brain.isActive(ActivityMCA.GRIEVE.get()) && !brain.isActive(ActivityMCA.SWIM.get())
+                && !villager.getSwimwearOutfit().isEmpty()
+                && !villager.isBaby() && DeviantLines.isAdult(villager.getAgeState())
+                && !villager.isGuard() && !villager.isSleeping() && !villager.isPassenger() && !villager.isTrading()
+                && !brain.hasMemoryValue(MemoryModuleTypeMCA.STAYING.get())
+                && !brain.hasMemoryValue(MemoryModuleTypeMCA.PLAYER_FOLLOWING.get())
+                && !brain.hasMemoryValue(MemoryModuleType.ATTACK_TARGET)
+                && !brain.hasMemoryValue(MemoryModuleType.HURT_BY)
+                && !level.isThundering();
+    }
+
+    /** Looks for a pool near her bed and a place at its edge she can walk to. */
+    private boolean findPool(ServerLevel level, VillagerEntityMCA villager, boolean cached) {
+        BlockPos origin = villager.getBrain().getMemory(MemoryModuleType.HOME)
+                .filter(home -> home.dimension() == level.dimension())
+                .map(home -> home.pos())
+                .orElse(null);
+        if (origin == null) {
+            return false;
+        }
+        for (PoolFinder.Pool candidate : cached ? PoolFinder.findCached(level, origin) : PoolFinder.find(level, origin)) {
+            BlockPos edge = findShore(level, villager, candidate);
+            if (edge != null) {
+                pool = candidate;
+                shore = edge;
+                water = new ArrayList<>(candidate.surface());
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** A spot she can stand on next to the water: solid ground, two blocks of air, and the water at her feet or just below. */
+    public static BlockPos findShore(ServerLevel level, VillagerEntityMCA villager, PoolFinder.Pool candidate) {
+        return findShore(level, villager, candidate, null);
+    }
+
+    /**
+     * Picks the edge spot to walk to. A complete path is best, but a partial one is fine too (the pathfinder only searches so many
+     * blocks at a time, for example from an upstairs bed through the house): she walks as far as it goes and plans again from there.
+     * If notes is given, it is filled with what was found, for the debug pool button.
+     */
+    public static BlockPos findShore(ServerLevel level, VillagerEntityMCA villager, PoolFinder.Pool candidate, List<String> notes) {
+        List<BlockPos> spots = new ArrayList<>();
+        java.util.Set<BlockPos> seen = new java.util.HashSet<>();
+        for (BlockPos w : candidate.surface()) {
+            for (Direction direction : Direction.Plane.HORIZONTAL) {
+                for (int dy = 0; dy <= 1; dy++) {
+                    BlockPos p = w.relative(direction).above(dy);
+                    if (seen.add(p) && canStand(level, p)) {
+                        spots.add(p);
+                    }
+                }
+            }
+        }
+        spots.sort(java.util.Comparator.comparingDouble(p -> p.distSqr(villager.blockPosition())));
+        if (notes != null) {
+            notes.add(spots.size() + " spots at the water's edge where she could stand.");
+        }
+        BlockPos partial = null;
+        int tries = 0;
+        for (BlockPos p : spots) {
+            if (tries++ >= 12) {
+                break;
+            }
+            Path path = longPath(villager, p);
+            if (path == null) {
+                if (notes != null && tries <= 3) {
+                    notes.add("Spot " + p.getX() + " " + p.getY() + " " + p.getZ() + ": the pathfinder finds no path at all"
+                            + (villager.onGround() ? "." : " (she is not standing on the ground right now)."));
+                }
+                continue;
+            }
+            if (path.canReach()) {
+                if (notes != null) {
+                    notes.add("Spot " + p.getX() + " " + p.getY() + " " + p.getZ() + ": complete path of " + path.getNodeCount() + " steps.");
+                }
+                return p;
+            }
+            if (notes != null && tries <= 3) {
+                notes.add("Spot " + p.getX() + " " + p.getY() + " " + p.getZ() + ": only a partial path of " + path.getNodeCount() + " steps (it stops short of the spot).");
+            }
+            if (partial == null && path.getNodeCount() > 1) {
+                partial = p;
+            }
+        }
+        if (partial != null && notes != null) {
+            notes.add("Using the partial path: she walks as far as it goes and plans again from there.");
+        }
+        return partial;
+    }
+
+    /** A path with a big search budget (see MCAGroundPathNavigation.createLongPath), or the normal one if that is not available. */
+    private static Path longPath(VillagerEntityMCA villager, BlockPos target) {
+        if (villager.getNavigation() instanceof net.conczin.mca.entity.ai.navigation.MCAGroundPathNavigation navigation) {
+            return navigation.createLongPath(target, 0, LONG_PATH_NODES);
+        }
+        return villager.getNavigation().createPath(target, 0);
+    }
+
+    private static void walkTo(VillagerEntityMCA villager, BlockPos target) {
+        Path path = longPath(villager, target);
+        if (path != null && path.getNodeCount() > 1) {
+            villager.getNavigation().moveTo(path, SPEED);
+        } else {
+            villager.getNavigation().moveTo(target.getX() + 0.5, target.getY(), target.getZ() + 0.5, SPEED);
+        }
+    }
+
+    private static boolean canStand(ServerLevel level, BlockPos p) {
+        BlockPos below = p.below();
+        return level.getBlockState(below).isFaceSturdy(level, below, Direction.UP)
+                && level.getFluidState(p).isEmpty() && level.getBlockState(p).getCollisionShape(level, p).isEmpty()
+                && level.getFluidState(p.above()).isEmpty() && level.getBlockState(p.above()).getCollisionShape(level, p.above()).isEmpty();
+    }
+
+    @Override
+    protected void start(ServerLevel level, VillagerEntityMCA villager, long time) {
+        var brain = villager.getBrain();
+        brain.eraseMemory(MemoryModuleType.PATH);
+        brain.eraseMemory(MemoryModuleType.WALK_TARGET);
+        brain.eraseMemory(MemoryModuleType.LOOK_TARGET);
+        brain.eraseMemory(MemoryModuleType.BREED_TARGET);
+        brain.eraseMemory(MemoryModuleType.INTERACTION_TARGET);
+        villager.getMCABrain().setActiveActivityIfPossible(ActivityMCA.SWIM.get());
+        if (!forced) {
+            nextIndex++;
+            postponed = false;
+        }
+
+        // every player nearby hears a line that fits their relationship with her, then she waits a moment and changes
+        ServerPlayer closest = null;
+        for (ServerPlayer player : level.players()) {
+            if (player.isSpectator() || player.distanceToSqr(villager) > AUDIENCE_RANGE * AUDIENCE_RANGE) {
+                continue;
+            }
+            String line = forced && player == requester ? BedtimeLines.pickSwimNow(villager, player, true) : BedtimeLines.pickSwim(villager, player);
+            if (line == null) {
+                continue;
+            }
+            villager.sendChatMessage(Component.literal(line), player);
+            // she looks at her spouse if he is there, otherwise at the closest player
+            boolean spouse = villager.getRelationships().isMarriedTo(player.getUUID());
+            boolean closestIsSpouse = closest != null && villager.getRelationships().isMarriedTo(closest.getUUID());
+            if (closest == null || (spouse && !closestIsSpouse)
+                    || (spouse == closestIsSpouse && player.distanceToSqr(villager) < closest.distanceToSqr(villager))) {
+                closest = player;
+            }
+        }
+        if (closest != null) {
+            brain.setMemory(MemoryModuleType.LOOK_TARGET, new EntityTracker(closest, true));
+            freeze(villager);
+            enter(Phase.TALKING, time);
+        } else {
+            villager.setSwimOutfit(true);
+            enter(Phase.WALKING, time);
+        }
+    }
+
+    private void enter(Phase next, long time) {
+        phase = next;
+        phaseStart = time;
+    }
+
+    @Override
+    protected boolean canStillUse(ServerLevel level, VillagerEntityMCA villager, long time) {
+        return phase != Phase.IDLE;
+    }
+
+    @Override
+    protected void tick(ServerLevel level, VillagerEntityMCA villager, long time) {
+        var brain = villager.getBrain();
+        if (!brain.isActive(ActivityMCA.SWIM.get()) || villager.isSleeping() || brain.hasMemoryValue(MemoryModuleType.ATTACK_TARGET)
+                || brain.hasMemoryValue(MemoryModuleType.HURT_BY) || villager.getVillagerBrain().isPanicking()) {
+            phase = Phase.IDLE;
+            return;
+        }
+        brain.eraseMemory(MemoryModuleType.WALK_TARGET);
+        long elapsed = time - phaseStart;
+        if (phase == Phase.WALKING || (phase == Phase.LEAVING && !villager.isInWater())) {
+            shareWalkingPath(villager);
+        }
+        int timeOfDay = (int) (level.getDayTime() % 24000L);
+
+        switch (phase) {
+            case TALKING -> {
+                freeze(villager);
+                if (elapsed >= LINE_DELAY) {
+                    villager.setSwimOutfit(true);
+                    enter(Phase.WALKING, time);
+                }
+            }
+            case WALKING -> {
+                if (villager.isInWater() || near(villager, shore, 2.25)) {
+                    nextMove = 0;
+                    enter(Phase.ENTERING, time);
+                } else if (elapsed > WALK_TIMEOUT) {
+                    phase = Phase.IDLE;
+                } else if (elapsed % 20 == 0 && villager.getNavigation().isDone()) {
+                    walkTo(villager, shore);
+                }
+            }
+            case ENTERING -> {
+                if (villager.isInWater() && villager.getFluidHeight(net.minecraft.tags.FluidTags.WATER) > 0.4) {
+                    swimEnd = time + MIN_DURATION + villager.getRandom().nextInt(MAX_DURATION - MIN_DURATION + 1);
+                    enter(Phase.SWIMMING, time);
+                } else if (elapsed > ENTER_TIMEOUT) {
+                    phase = Phase.IDLE;
+                } else {
+                    swimTowards(villager, water.get(villager.getRandom().nextInt(water.size())));
+                }
+            }
+            case SWIMMING -> {
+                if (time >= swimEnd || (!forced && (timeOfDay >= LATEST_END || timeOfDay < WINDOW_START))) {
+                    enter(Phase.LEAVING, time);
+                } else {
+                    // she drifts to a spot in the pool, rests a moment, then drifts on to the next one
+                    if (swimTarget != null && !pushTowards(villager, swimTarget, SWIM_SPEED)) {
+                        swimTarget = null;
+                    }
+                    if (swimTarget == null && time >= nextMove) {
+                        swimTarget = pickSpot(villager);
+                        nextMove = time + 40 + villager.getRandom().nextInt(80);
+                    }
+                }
+            }
+            case LEAVING -> {
+                if (!villager.isInWater() && near(villager, shore, 4.0)) {
+                    phase = Phase.IDLE;
+                } else if (elapsed > LEAVE_TIMEOUT) {
+                    phase = Phase.IDLE;
+                } else if (villager.isInWater()) {
+                    pushTowards(villager, shore, SWIM_SPEED * 1.3);
+                } else if (elapsed % 20 == 0 && villager.getNavigation().isDone()) {
+                    walkTo(villager, shore);
+                }
+            }
+            default -> {
+            }
+        }
+    }
+
+    private static void freeze(VillagerEntityMCA villager) {
+        villager.getNavigation().stop();
+        villager.getBrain().eraseMemory(MemoryModuleType.WALK_TARGET);
+        villager.getMoveControl().setWantedPosition(villager.getX(), villager.getY(), villager.getZ(), 0.0);
+    }
+
+    /**
+     * Water barely moves a walking mob (the normal movement control only gives it a tiny push in water), so in the pool she is
+     * pushed along by hand. Returns false when she has arrived.
+     */
+    private static boolean pushTowards(VillagerEntityMCA villager, BlockPos target, double speed) {
+        double dx = target.getX() + 0.5 - villager.getX();
+        double dz = target.getZ() + 0.5 - villager.getZ();
+        double distance = Math.sqrt(dx * dx + dz * dz);
+        if (distance < 0.7) {
+            return false;
+        }
+        var motion = villager.getDeltaMovement();
+        villager.setDeltaMovement(motion.x * 0.7 + dx / distance * speed * 0.3, motion.y, motion.z * 0.7 + dz / distance * speed * 0.3);
+        float yaw = (float) (Mth.atan2(dz, dx) * (180.0F / Math.PI)) - 90.0F;
+        float turned = Mth.approachDegrees(villager.getYRot(), yaw, 20.0F);
+        villager.setYRot(turned);
+        villager.yBodyRot = turned;
+        villager.setYHeadRot(turned);
+        return true;
+    }
+
+    /** A spot in the pool at least a couple of blocks from where she is. */
+    private BlockPos pickSpot(VillagerEntityMCA villager) {
+        BlockPos best = water.get(villager.getRandom().nextInt(water.size()));
+        for (int i = 0; i < 6; i++) {
+            BlockPos candidate = water.get(villager.getRandom().nextInt(water.size()));
+            if (candidate.distSqr(villager.blockPosition()) >= 4) {
+                return candidate;
+            }
+        }
+        return best;
+    }
+
+    /**
+     * She walks with the navigation directly, but the tasks that open and close doors only look at the path in her brain
+     * (normally put there by the walk-to-target task). Without this she stands in front of a closed door and waits.
+     */
+    private static void shareWalkingPath(VillagerEntityMCA villager) {
+        Path path = villager.getNavigation().getPath();
+        if (path != null && !path.isDone()) {
+            villager.getBrain().setMemory(MemoryModuleType.PATH, path);
+        } else {
+            villager.getBrain().eraseMemory(MemoryModuleType.PATH);
+        }
+    }
+
+    private static void swimTowards(VillagerEntityMCA villager, BlockPos target) {
+        villager.getMoveControl().setWantedPosition(target.getX() + 0.5, target.getY() + 0.5, target.getZ() + 0.5, SPEED);
+    }
+
+    private static boolean near(VillagerEntityMCA villager, BlockPos pos, double distanceSqr) {
+        return villager.distanceToSqr(pos.getX() + 0.5, pos.getY(), pos.getZ() + 0.5) <= distanceSqr;
+    }
+
+    @Override
+    protected void stop(ServerLevel level, VillagerEntityMCA villager, long time) {
+        phase = Phase.IDLE;
+        lastEnd = level.getDayTime();
+        forced = false;
+        requester = null;
+        pool = null;
+        swimTarget = null;
+        villager.setSwimOutfit(false);
+        villager.getNavigation().stop();
+        villager.getBrain().updateActivityFromSchedule(level.getDayTime(), level.getGameTime());
+    }
+}
