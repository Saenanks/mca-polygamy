+package net.conczin.mca.network.c2s;
+
+import net.conczin.mca.cobalt.network.Message;
+import net.conczin.mca.server.outfits.OutfitServerStore;
+import net.minecraft.server.level.ServerPlayer;
+
+import java.io.Serial;
+import java.util.ArrayList;
+import java.util.List;
+
+/** The player's swimwear or sleepwear tab changed: the server keeps the list, so it comes back with the player's library. */
+public class OutfitListMessage implements Message {
+    @Serial
+    private static final long serialVersionUID = 6310112304116009L;
+
+    private final String kind;
+    private final ArrayList<String> hashes;
+
+    public OutfitListMessage(String kind, ArrayList<String> hashes) {
+        this.kind = kind;
+        this.hashes = hashes;
+    }
+
+    @Override
+    public void receive(ServerPlayer player) {
+        if (!"swimwear".equals(kind) && !"sleepwear".equals(kind)) {
+            return;
+        }
+        List<String> clean = new ArrayList<>();
+        for (String hash : hashes) {
+            if (OutfitServerStore.isValidHash(hash) && clean.size() < 300) clean.add(hash);
+        }
+        OutfitServerStore.setList(player.server, player.getUUID(), kind, clean);
+    }
+}
