+import java.io.File;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.io.Reader;
+import java.io.Writer;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Deviant addon: the extra lines a Deviant villager says for flirt, chat, kiss and hug, and the greeting for her spouse when he comes home. They are added to the normal
+ * dialogue pool, so every line (normal or custom) is equally likely. A female adult villager becomes Deviant once her
+ * relationship with a player reaches 400 hearts.
+ * The lines live in config/mca_deviant_lines.json. The file is created with the defaults below on first use
+ * and is re-read automatically whenever it changes, so it can be edited without rebuilding the mod.
+ */
+public final class DeviantLines {
+    /** Hearts a player needs with the villager before she becomes Deviant and uses these lines. */
+    public static final int HEARTS_REQUIRED = 400;
+
+    private static final Gson GSON = new GsonBuilder().setPrettyPrinting().disableHtmlEscaping().create();
+    private static final File FILE = new File("./config/mca_deviant_lines.json");
+
+    private static final Map<String, String> DIALOGUE_TO_CATEGORY = Map.of(
+            "flirt.success", "flirt",
+            "chat.topic", "chat",
+            "kiss.success", "kiss",
+            "hug.success", "hug"
+    );
+
+    private static final Set<String> NEVER_NEGATIVE = Set.of("flirt", "chat", "kiss", "hug");
+
+    private static final Map<String, Integer> VANILLA_COUNTS = new HashMap<>();
+
+    private static Map<String, List<String>> lines = defaults();
+    private static long loadedStamp = Long.MIN_VALUE;
+
+    private DeviantLines() {
+    }
+
+    /**
+     * Sometimes sends a custom line instead of the normal reply when this villager qualifies. Every normal line and every
+     * custom line is equally likely, so the custom lines join the normal pool.
+     *
+     * @return true if a custom line was sent and the normal reply should be skipped.
+     */
+    public static boolean tryHandle(VillagerEntityMCA villager, ServerPlayer player, String dialogueId) {
+        String category = DIALOGUE_TO_CATEGORY.get(dialogueId);
+        if (category == null) {
+            return false;
+        }
+
+        if (!isEligible(villager, villager.getVillagerBrain().getMemoriesForPlayer(player))
+                || !net.conczin.mca.server.world.data.PlayerSaveData.get(player).areDeviantLinesEnabled()) {
+            return false;
+        }
+
+        // a married Deviant villager only says these lines to the person she is married to
+        if (villager.getRelationships().isMarried() && !villager.getRelationships().isMarriedTo(player.getUUID())) {
+            return false;
+        }
+
+        List<String> options = getLines(category);
+        if (options.isEmpty()) {
+            return false;
+        }
+
+        // one draw over the custom lines plus the normal ones; landing on a normal one means the normal reply is used
+        int pick = villager.getRandom().nextInt(options.size() + vanillaLineCount(dialogueId));
+        if (pick >= options.size()) {
+            return false;
+        }
+        villager.sendChatMessage(Component.literal(options.get(pick)), player);
+        return true;
+    }
+
+
+    /**
+     * A married Deviant villager with at least 400 hearts towards her spouse greets him with one of these lines when he comes home after being away. The custom
+     * lines join the two normal spouse greetings, so every line is equally likely.
+     *
+     * @return true if a custom line was sent and the normal greeting should be skipped.
+     */
+    public static boolean tryWelcome(VillagerEntityMCA villager, ServerPlayer player) {
+        if (!Traits.DEVIANT.isEnabled()
+                || villager.getGenetics().getGender() != Gender.FEMALE
+                || villager.asEntity().isBaby()
+                || !isAdult(villager.getAgeState())
+                || !villager.getTraits().hasTrait(Traits.DEVIANT)
+                || !villager.getRelationships().isMarriedTo(player.getUUID())
+                || villager.getVillagerBrain().getMemoriesForPlayer(player).getHearts() < HEARTS_REQUIRED
+                || !net.conczin.mca.server.world.data.PlayerSaveData.get(player).areDeviantLinesEnabled()) {
+            return false;
+        }
+
+        List<String> options = getLines("welcome");
+        if (options.isEmpty()) {
+            return false;
+        }
+
+        int pick = villager.getRandom().nextInt(options.size() + 2);
+        if (pick >= options.size()) {
+            return false;
+        }
+        String text = options.get(pick).replace("%1$s", player.getName().getString());
+        villager.conversationManager.addMessage(new ConversationManager.TextMessage(player, Component.literal(text)));
+        return true;
+    }
+
+    /**
+     * Female, adult and at 400 hearts or more with the given player: she is Deviant, and gets the trait now if she did
+     * not have it yet.
+     */
+    public static boolean isEligible(VillagerLike<?> villager, Memories memories) {
+        if (!Traits.DEVIANT.isEnabled()
+                || villager.getGenetics().getGender() != Gender.FEMALE
+                || villager.asEntity().isBaby()
+                || !isAdult(villager.getAgeState())
+                || memories.getHearts() < HEARTS_REQUIRED) {
+            return false;
+        }
+        if (!villager.getTraits().hasTrait(Traits.DEVIANT)) {
+            villager.getTraits().addTrait(Traits.DEVIANT);
+        }
+        return villager.getTraits().hasTrait(Traits.DEVIANT);
+    }
+
+    /**
+     * Called whenever a villager's memory of a player changes, so she becomes Deviant as soon as the relationship reaches 400 hearts.
+     */
+    public static void grantTraitIfEligible(VillagerLike<?> villager, Memories memories) {
+        if (!villager.asEntity().level().isClientSide) {
+            isEligible(villager, memories);
+        }
+    }
+
+    /** Number of normal replies the game has for this interaction, so the custom lines can be mixed in fairly. */
+    private static synchronized int vanillaLineCount(String dialogueId) {
+        return VANILLA_COUNTS.computeIfAbsent(dialogueId, id -> {
+            String prefix = "dialogue." + (id.equals("chat.topic") ? "chat.success" : id) + "/";
+            try (Reader reader = new InputStreamReader(DeviantLines.class.getResourceAsStream("/assets/mca_dialogue/lang/en_us.json"), StandardCharsets.UTF_8)) {
+                JsonObject json = GSON.fromJson(reader, JsonObject.class);
+                int count = 0;
+                for (String key : json.keySet()) {
+                    if (key.startsWith(prefix)) {
+                        count++;
+                    }
+                }
+                return Math.max(1, count);
+            } catch (Exception e) {
+                return 8;
+            }
+        });
