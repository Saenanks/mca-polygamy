+package net.conczin.mca.network.c2s;
+
+import net.conczin.mca.cobalt.network.Message;
+import net.conczin.mca.entity.VillagerEntityMCA;
+import net.conczin.mca.server.outfits.OutfitServerStore;
+import net.minecraft.network.chat.Component;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.entity.Entity;
+
+import java.io.Serial;
+import java.util.UUID;
+
+/** Chooses the sleepwear or swimwear of a villager (the texture hash), or an empty hash for normal clothes. */
+public class VillagerOutfitMessage implements Message {
+    @Serial
+    private static final long serialVersionUID = 6310112304116005L;
+
+    private final UUID villager;
+    private final String kind;
+    private final String hash;
+
+    public VillagerOutfitMessage(UUID villager, String kind, String hash) {
+        this.villager = villager;
+        this.kind = kind;
+        this.hash = hash;
+    }
+
+    @Override
+    public void receive(ServerPlayer player) {
+        Entity entity = player.serverLevel().getEntity(villager);
+        if (!(entity instanceof VillagerEntityMCA v) || v.distanceToSqr(player) > 64 * 64) {
+            return;
+        }
+        String value = hash == null ? "" : hash;
+        if (value.startsWith("mod:")) {
+            // one of the mod's own outfits: it only has to be a clothes entry the mod knows
+            var list = net.conczin.mca.resources.ClothingList.getInstance();
+            if (list == null || !list.clothing.containsKey(value.substring(4))) {
+                player.displayClientMessage(Component.literal("That is not one of the outfits of the mod."), true);
+                return;
+            }
+        } else if (!value.isEmpty() && (!OutfitServerStore.isValidHash(value) || OutfitServerStore.readTexture(player.server, value) == null)) {
+            player.displayClientMessage(Component.literal("The server does not have that outfit texture, so it could not be set."), true);
+            return;
+        }
+        if ("sleepwear".equals(kind)) {
+            v.setSleepwearOutfit(value);
+        } else if ("swimwear".equals(kind)) {
+            v.setSwimwearOutfit(value);
+        }
+    }
+}
