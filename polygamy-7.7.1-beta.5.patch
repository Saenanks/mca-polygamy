@@ -0,0 +1,48 @@
+package net.conczin.mca.network.c2s;
+
+import net.conczin.mca.cobalt.network.Message;
+import net.conczin.mca.cobalt.network.NetworkHandler;
+import net.conczin.mca.network.s2c.OutfitLibraryEntryMessage;
+import net.conczin.mca.network.s2c.OutfitSyncResponse;
+import net.conczin.mca.server.outfits.OutfitServerStore;
+import net.minecraft.server.level.ServerPlayer;
+
+import java.io.Serial;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * The outfits menu was opened: the client says which saved outfits it has (hashes). The server sends back the ones from the
+ * player's library that are missing locally, and the list of what it has, so the client can upload what the server lacks.
+ */
+public class OutfitSyncRequest implements Message {
+    @Serial
+    private static final long serialVersionUID = 6310112304116004L;
+    private static final int MAX_RESTORE = 100;
+
+    private final ArrayList<String> localHashes;
+
+    public OutfitSyncRequest(ArrayList<String> localHashes) {
+        this.localHashes = localHashes;
+    }
+
+    @Override
+    public void receive(ServerPlayer player) {
+        List<OutfitServerStore.Entry> library = OutfitServerStore.getLibrary(player.server, player.getUUID());
+        ArrayList<String> serverHashes = new ArrayList<>();
+        int sent = 0;
+        for (OutfitServerStore.Entry entry : library) {
+            serverHashes.add(entry.hash());
+            if (!localHashes.contains(entry.hash()) && sent < MAX_RESTORE) {
+                byte[] png = OutfitServerStore.readTexture(player.server, entry.hash());
+                if (png != null) {
+                    NetworkHandler.sendToPlayer(new OutfitLibraryEntryMessage(entry.name(), entry.contentId(), png), player);
+                    sent++;
+                }
+            }
+        }
+        NetworkHandler.sendToPlayer(new OutfitSyncResponse(serverHashes,
+                new ArrayList<>(OutfitServerStore.getList(player.server, player.getUUID(), "swimwear")),
+                new ArrayList<>(OutfitServerStore.getList(player.server, player.getUUID(), "sleepwear"))), player);
+    }
+}
