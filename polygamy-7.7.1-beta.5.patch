+package net.conczin.mca.client.gui;
+
+import net.conczin.mca.client.OutfitStore;
+import net.conczin.mca.entity.EntitiesMCA;
+import net.conczin.mca.entity.VillagerEntityMCA;
+import net.conczin.mca.entity.VillagerLike;
+import net.conczin.mca.entity.ai.relationship.Gender;
+import net.conczin.mca.cobalt.network.NetworkHandler;
+import net.conczin.mca.network.c2s.VillagerEditorSyncRequest;
+import net.conczin.mca.util.compat.ButtonWidget;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.GuiGraphics;
+import net.minecraft.client.gui.screens.Screen;
+import net.minecraft.client.gui.screens.inventory.InventoryScreen;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.network.chat.Component;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import java.util.UUID;
+
+/**
+ * The outfits menu of a villager (button "Outfits" in the interaction menu).
+ * <ul>
+ *   <li>Saved: every outfit saved from the player made skin library. Click one for a menu: apply it to the villager,
+ *   add it to the swimwear or sleepwear tab, or delete it.</li>
+ *   <li>Swimwear / Sleepwear: the outfits added to that tab. Click one to make this villager use it; right click for more.</li>
+ * </ul>
+ */
+public class OutfitsScreen extends Screen {
+    private static final String SAVED = "saved";
+    private static final int COLUMNS = 6;
+    private static final int ROWS = 2;
+    private static final int PER_PAGE = COLUMNS * ROWS;
+
+    private final UUID villagerUuid;
+    private final VillagerLike<?> villager;
+    private boolean sleepwearSent;
+    private final Screen previous;
+    private final VillagerEntityMCA preview = Objects.requireNonNull(EntitiesMCA.MALE_VILLAGER.get().create(Objects.requireNonNull(Minecraft.getInstance().level)));
+    private final CompoundTag baseData = new CompoundTag();
+    private final Gender gender;
+
+    private String tab = SAVED;
+    private int page = 0;
+    /** Tiles of the current tab. A null entry is the "normal clothes" tile. */
+    private List<OutfitStore.Outfit> tiles = new ArrayList<>();
+    /** The outfit the popup menu is open for. */
+    private OutfitStore.Outfit popup = null;
+
+    public OutfitsScreen(UUID villagerUuid, VillagerLike<?> villager, Screen previous) {
+        super(Component.translatable("gui.mca.outfits.title"));
+        this.villagerUuid = villagerUuid;
+        this.villager = villager;
+        this.sleepwearSent = villager.isSleepwearSet();
+        this.previous = previous;
+
+        if (villager instanceof VillagerEntityMCA v) {
+            v.addAdditionalSaveData(baseData);
+        }
+        preview.readAdditionalSaveData(baseData.copy());
+        this.gender = villager.getGenetics().getGender();
+        reloadTiles();
+        syncSleepwear();
+    }
+
+    /** Tells the server whether a sleepwear outfit is chosen for this villager, so the bedtime routine only happens then. */
+    private void syncSleepwear() {
+        boolean enabled = OutfitStore.resolve(villagerUuid, OutfitStore.SLEEPWEAR) != null;
+        if (enabled != sleepwearSent) {
+            sleepwearSent = enabled;
+            CompoundTag tag = new CompoundTag();
+            tag.putBoolean("Enabled", enabled);
+            NetworkHandler.sendToServer(new VillagerEditorSyncRequest("sleepwear", villagerUuid, tag));
+        }
+    }
+
+    private void reloadTiles() {
+        tiles = new ArrayList<>();
+        if (tab.equals(SAVED)) {
+            tiles.addAll(OutfitStore.listAll());
+        } else {
+            tiles.add(null);
+            tiles.addAll(OutfitStore.list(tab));
+        }
+        int pages = Math.max(1, (tiles.size() + PER_PAGE - 1) / PER_PAGE);
+        page = Math.max(0, Math.min(page, pages - 1));
+    }
+
+    private void refresh() {
+        reloadTiles();
+        rebuildWidgets();
+    }
+
+    @Override
+    protected void init() {
+        super.init();
+        reloadTiles();
+        int cx = width / 2;
+
+        if (popup != null) {
+            initPopup();
+            return;
+        }
+
+        String[] tabs = {SAVED, OutfitStore.SWIMWEAR, OutfitStore.SLEEPWEAR};
+        for (int i = 0; i < tabs.length; i++) {
+            String t = tabs[i];
+            ButtonWidget b = addRenderableWidget(new ButtonWidget(cx - 210 + i * 105, 12, 100, 20,
+                    Component.translatable("gui.mca.outfits.tab." + t), button -> {
+                tab = t;
+                page = 0;
+                refresh();
+            }));
+            b.active = !tab.equals(t);
+        }
+        addRenderableWidget(new ButtonWidget(cx - 210 + 3 * 105, 12, 100, 20,
+                Component.translatable("gui.mca.outfits.tab.library"),
+                button -> Minecraft.getInstance().setScreen(new SkinLibraryScreen().returnTo(this))));
+
+        int pages = Math.max(1, (tiles.size() + PER_PAGE - 1) / PER_PAGE);
+        int by = height - 28;
+        addRenderableWidget(new ButtonWidget(cx - 110, by, 30, 20, Component.literal("<<"), b -> {
+            page--;
+            rebuildWidgets();
+        })).active = page > 0;
+        addRenderableWidget(new ButtonWidget(cx + 80, by, 30, 20, Component.literal(">>"), b -> {
+            page++;
+            rebuildWidgets();
+        })).active = page < pages - 1;
+        addRenderableWidget(new ButtonWidget(cx - 40, by, 80, 20, Component.translatable("gui.mca.outfits.done"), b -> onClose()));
+    }
+
+    private void initPopup() {
+        int x = width / 2 + 10;
+        int y = height / 2 - 60;
+        int w = 150;
+        int step = 24;
+        OutfitStore.Outfit o = popup;
+
+        if (tab.equals(SAVED)) {
+            ButtonWidget apply = addRenderableWidget(new ButtonWidget(x, y, w, 20, Component.translatable("gui.mca.outfits.apply"), b -> {
+                applyToVillager(o);
+                closePopup();
+            }));
+            apply.active = o.contentId() > 0;
+            y += step;
+            for (String kind : new String[]{OutfitStore.SWIMWEAR, OutfitStore.SLEEPWEAR}) {
+                boolean in = OutfitStore.isInList(kind, o.id());
+                addRenderableWidget(new ButtonWidget(x, y, w, 20,
+                        Component.translatable("gui.mca.outfits." + (in ? "remove_from_" : "add_to_") + kind), b -> {
+                    if (in) OutfitStore.removeFromList(kind, o.id());
+                    else OutfitStore.addToList(kind, o.id());
+                    closePopup();
+                }));
+                y += step;
+            }
+            addRenderableWidget(new ButtonWidget(x, y, w, 20, Component.translatable("gui.mca.outfits.delete"), b -> {
+                OutfitStore.delete(o.id());
+                closePopup();
+            }));
+            y += step;
+        } else {
+            addRenderableWidget(new ButtonWidget(x, y, w, 20, Component.translatable("gui.mca.outfits.use"), b -> {
+                OutfitStore.setChoice(villagerUuid, tab, o.id());
+                closePopup();
+            }));
+            y += step;
+            addRenderableWidget(new ButtonWidget(x, y, w, 20, Component.translatable("gui.mca.outfits.automatic"), b -> {
+                OutfitStore.setChoice(villagerUuid, tab, null);
+                closePopup();
+            }));
+            y += step;
+            addRenderableWidget(new ButtonWidget(x, y, w, 20, Component.translatable("gui.mca.outfits.remove_from_tab"), b -> {
+                OutfitStore.removeFromList(tab, o.id());
+                closePopup();
+            }));
+            y += step;
+        }
+        addRenderableWidget(new ButtonWidget(x, y, w, 20, Component.translatable("gui.mca.outfits.cancel"), b -> closePopup()));
+    }
+
+    private void closePopup() {
+        popup = null;
+        syncSleepwear();
+        refresh();
+    }
+
+    private void applyToVillager(OutfitStore.Outfit o) {
+        CompoundTag patch = new CompoundTag();
+        patch.putString("Clothes", "immersive_library:" + o.contentId());
+        NetworkHandler.sendToServer(new VillagerEditorSyncRequest("clothing", villagerUuid, patch));
+        if (Minecraft.getInstance().player != null) {
+            Minecraft.getInstance().player.displayClientMessage(Component.translatable("gui.mca.outfits.applied", o.label()), true);
+        }
+    }
+
+    @Override
+    public void onClose() {
+        if (popup != null) {
+            closePopup();
+            return;
+        }
+        Minecraft.getInstance().setScreen(previous);
+    }
+
+    private int tileX(int tile) {
+        return width / 2 + (int) ((tile % COLUMNS - COLUMNS / 2.0 + 0.5) * 58);
+    }
+
+    private int tileY(int tile) {
+        return 120 + (tile / COLUMNS) * 100;
+    }
+
+    private boolean over(int tile, double mx, double my) {
+        int cx = tileX(tile);
+        int cy = tileY(tile);
+        return Math.abs(cx - mx) <= 28 && my >= cy - 62 && my <= cy + 6;
+    }
+
+    private boolean tileExists(int tile) {
+        return page * PER_PAGE + tile < tiles.size();
+    }
+
+    private OutfitStore.Outfit tileOutfit(int tile) {
+        return tiles.get(page * PER_PAGE + tile);
+    }
+
+    private boolean isSelected(int tile) {
+        if (tab.equals(SAVED)) return false;
+        String choice = OutfitStore.getChoice(villagerUuid, tab);
+        OutfitStore.Outfit o = tileOutfit(tile);
+        return o == null ? choice == null || OutfitStore.NONE.equals(choice) : o.id().equals(choice);
+    }
+
+    private void drawPreview(GuiGraphics context, OutfitStore.Outfit outfit, int cx, int cy, int scale, float lookX, float lookY) {
+        preview.readAdditionalSaveData(baseData.copy());
+        preview.setAge(0);
+        preview.getGenetics().setGender(gender.binary());
+        if (outfit != null) {
+            preview.setClothes(outfit.texture());
+        }
+        InventoryScreen.renderEntityInInventoryFollowsMouse(context, cx, cy, scale, lookX, lookY, preview);
+    }
+
+    @Override
+    public void render(GuiGraphics context, int mouseX, int mouseY, float delta) {
+        renderBackground(context);
+
+        if (popup != null) {
+            context.drawCenteredString(font, Component.literal(popup.label()), width / 2, 40, 0xFFFFFFFF);
+            int cx = width / 2 - 70;
+            int cy = height / 2 + 70;
+            drawPreview(context, popup, cx, cy, 70, -(mouseX - cx) / 2.0f, -(mouseY - cy + 100) / 2.0f);
+            super.render(context, mouseX, mouseY, delta);
+            return;
+        }
+
+        context.drawCenteredString(font, Component.translatable("gui.mca.outfits.help." + tab), width / 2, 38, 0xFFCCCCCC);
+
+        Component tooltip = null;
+        for (int tile = 0; tile < PER_PAGE && tileExists(tile); tile++) {
+            int cx = tileX(tile);
+            int cy = tileY(tile);
+            OutfitStore.Outfit outfit = tileOutfit(tile);
+            boolean hovered = over(tile, mouseX, mouseY);
+
+            if (isSelected(tile)) {
+                context.fill(cx - 28, cy - 66, cx + 28, cy + 8, 0x6655FF55);
+            } else if (hovered) {
+                context.fill(cx - 28, cy - 66, cx + 28, cy + 8, 0x33FFFFFF);
+            }
+            if (hovered) {
+                tooltip = outfit == null ? Component.translatable("gui.mca.outfits.normal") : Component.literal(outfit.label());
+            }
+            drawPreview(context, outfit, cx, cy, hovered ? 32 : 30, -(mouseX - cx) / 2.0f, -(mouseY - cy + 30) / 2.0f);
+            if (outfit != null) {
+                String label = font.plainSubstrByWidth(outfit.label(), 54);
+                context.drawCenteredString(font, label, cx, cy + 12, 0xFFDDDDDD);
+            }
+        }
+
+        if (tiles.isEmpty()) {
+            context.drawCenteredString(font, Component.translatable("gui.mca.outfits.empty"), width / 2, height / 2, 0xFFFFAA55);
+        } else if (!tab.equals(SAVED) && tiles.size() == 1) {
+            context.drawCenteredString(font, Component.translatable("gui.mca.outfits.empty_tab"), width / 2, height / 2 + 60, 0xFFFFAA55);
+        }
+
+        super.render(context, mouseX, mouseY, delta);
+
+        if (tooltip != null) {
+            context.renderTooltip(font, tooltip, mouseX, mouseY);
+        }
+    }
+
+    @Override
+    public boolean mouseClicked(double mouseX, double mouseY, int button) {
+        if (super.mouseClicked(mouseX, mouseY, button)) {
+            return true;
+        }
+        if (popup != null) {
+            return false;
+        }
+        for (int tile = 0; tile < PER_PAGE && tileExists(tile); tile++) {
+            if (!over(tile, mouseX, mouseY)) continue;
+            OutfitStore.Outfit outfit = tileOutfit(tile);
+            if (tab.equals(SAVED)) {
+                popup = outfit;
+                rebuildWidgets();
+            } else if (outfit == null) {
+                OutfitStore.setChoice(villagerUuid, tab, null);
+                syncSleepwear();
+            } else if (button == 1) {
+                popup = outfit;
+                rebuildWidgets();
+            } else {
+                OutfitStore.setChoice(villagerUuid, tab, outfit.id());
+                syncSleepwear();
+            }
+            return true;
+        }
+        return false;
+    }
+}
