new file mode 100644
index 000000000..ab9c008e1
--- /dev/null
+++ b/common/src/main/java/net/conczin/mca/entity/ai/BedtimeLines.java
@@ -0,0 +1,125 @@
+package net.conczin.mca.entity.ai;
+
+import com.google.gson.Gson;
+import com.google.gson.GsonBuilder;
+import com.google.gson.reflect.TypeToken;
+import net.conczin.mca.MCA;
+import net.conczin.mca.entity.VillagerEntityMCA;
+import net.conczin.mca.entity.ai.relationship.Gender;
+import net.conczin.mca.server.world.data.PlayerSaveData;
+import net.minecraft.server.level.ServerPlayer;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.io.Reader;
+import java.io.Writer;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * The lines a villager says at her bed before she changes into her sleepwear (see BedtimeSleepTask).
+ * <ul>
+ *   <li>bedtime: she is not married to the player, comfy and innocent.</li>
+ *   <li>bedtime_married: she is married to the player, a little playful.</li>
+ *   <li>bedtime_deviant: she is married to the player and Deviant (same rules as the other Deviant lines).</li>
+ * </ul>
+ * Lines live in config/mca_bedtime_lines.json, created from the defaults on first use and re-read when edited.
+ * %1$s is replaced by the player's name.
+ */
+public final class BedtimeLines {
+    private static final Gson GSON = new GsonBuilder().setPrettyPrinting().disableHtmlEscaping().create();
+    private static final File FILE = new File("./config/mca_bedtime_lines.json");
+
+    private static Map<String, List<String>> lines = Map.of();
+    private static long loadedStamp = Long.MIN_VALUE;
+
+    private BedtimeLines() {
+    }
+
+    /** One random line for this villager and player, or null if there is none. */
+    public static String pick(VillagerEntityMCA villager, ServerPlayer player) {
+        String category = "bedtime";
+        if (villager.getRelationships().isMarriedTo(player.getUUID())) {
+            category = isDeviantSpouse(villager, player) ? "bedtime_deviant" : "bedtime_married";
+        }
+        List<String> options = getLines(category);
+        if (options.isEmpty()) {
+            return null;
+        }
+        return options.get(villager.getRandom().nextInt(options.size())).replace("%1$s", player.getName().getString());
+    }
+
+    /** The player must be her spouse. Same rules as the other Deviant lines: female adult with the trait, married to this player, 400 hearts, lines not switched off. */
+    public static boolean isDeviantSpouse(VillagerEntityMCA villager, ServerPlayer player) {
+        return villager.getRelationships().isMarriedTo(player.getUUID())
+                && Traits.DEVIANT.isEnabled()
+                && villager.getGenetics().getGender() == Gender.FEMALE
+                && DeviantLines.isAdult(villager.getAgeState())
+                && villager.getTraits().hasTrait(Traits.DEVIANT)
+                && villager.getVillagerBrain().getMemoriesForPlayer(player).getHearts() >= DeviantLines.HEARTS_REQUIRED
+                && PlayerSaveData.get(player).areDeviantLinesEnabled();
+    }
+
+    private static synchronized List<String> getLines(String category) {
+        long stamp = FILE.exists() ? FILE.lastModified() : -1;
+        if (stamp != loadedStamp) {
+            loadedStamp = stamp;
+            load();
+        }
+        return lines.getOrDefault(category, List.of());
+    }
+
+    private static Map<String, List<String>> defaults() {
+        try (Reader reader = new InputStreamReader(BedtimeLines.class.getResourceAsStream("/assets/mca/bedtime_lines_default.json"), StandardCharsets.UTF_8)) {
+            return GSON.fromJson(reader, new TypeToken<Map<String, List<String>>>() {
+            }.getType());
+        } catch (Exception e) {
+            MCA.LOGGER.warn("Could not read the built-in bedtime lines", e);
+            return Map.of();
+        }
+    }
+
+    private static void load() {
+        if (!FILE.exists()) {
+            lines = defaults();
+            try {
+                File parent = FILE.getParentFile();
+                if (parent != null) {
+                    //noinspection ResultOfMethodCallIgnored
+                    parent.mkdirs();
+                }
+                try (Writer writer = Files.newBufferedWriter(FILE.toPath(), StandardCharsets.UTF_8)) {
+                    GSON.toJson(lines, writer);
+                }
+                loadedStamp = FILE.lastModified();
+            } catch (IOException e) {
+                MCA.LOGGER.warn("Could not write {}", FILE, e);
+            }
+            return;
+        }
+        try (Reader reader = Files.newBufferedReader(FILE.toPath(), StandardCharsets.UTF_8)) {
+            Map<String, List<String>> loaded = GSON.fromJson(reader, new TypeToken<Map<String, List<String>>>() {
+            }.getType());
+            Map<String, List<String>> result = new java.util.LinkedHashMap<>();
+            if (loaded != null) {
+                loaded.forEach((key, value) -> {
+                    List<String> cleaned = new ArrayList<>();
+                    if (value != null) {
+                        for (String line : value) {
+                            if (line != null && !line.isBlank()) cleaned.add(line);
+                        }
+                    }
+                    result.put(key, cleaned);
+                });
+            }
+            lines = result;
+        } catch (Exception e) {
+            MCA.LOGGER.warn("Could not read {}, using the built-in lines instead", FILE, e);
+            lines = defaults();
+        }
+    }
+}
