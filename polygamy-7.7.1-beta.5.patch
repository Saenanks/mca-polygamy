@@ -0,0 +1,55 @@
+package net.conczin.mca.client.render.layer;
+
+import net.conczin.mca.client.OutfitStore;
+import net.conczin.mca.entity.VillagerLike;
+import net.conczin.mca.entity.ai.DeviantLines;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.world.entity.LivingEntity;
+import org.jetbrains.annotations.Nullable;
+
+import java.util.Map;
+import java.util.WeakHashMap;
+
+/**
+ * Special outfits: adult villagers wear a different outfit while they sleep and while they are in water.
+ * The outfit is chosen in the outfits menu and stored on the villager as a texture hash (see {@link OutfitStore}); a villager without a chosen outfit keeps her normal clothes.
+ */
+public final class SpecialOutfits {
+    public static final String SLEEPWEAR = OutfitStore.SLEEPWEAR;
+    public static final String SWIMWEAR = OutfitStore.SWIMWEAR;
+
+    /** How long the swimwear stays on after leaving the water, in ticks, so she does not flicker at the water's edge. */
+    private static final long SWIM_HOLD_TICKS = 60;
+
+    private static final Map<LivingEntity, Long> LAST_WET = new WeakHashMap<>();
+
+    private SpecialOutfits() {
+    }
+
+    /** The outfit this villager should wear right now instead of her normal clothes, or null. */
+    @Nullable
+    public static ResourceLocation get(LivingEntity entity, VillagerLike<?> villager) {
+        if (entity.isBaby() || !DeviantLines.isAdult(villager.getAgeState())) {
+            return null;
+        }
+
+        long now = entity.level().getGameTime();
+        if (entity.isInWater() || entity.isSwimming()) {
+            LAST_WET.put(entity, now);
+        }
+        Long wet = LAST_WET.get(entity);
+        boolean swimming = villager.isSwimOutfit() || (wet != null && now - wet >= 0 && now - wet <= SWIM_HOLD_TICKS);
+
+        String kind;
+        if (swimming) {
+            kind = SWIMWEAR;
+        } else if (entity.isSleeping() || villager.isBedtimeOutfit()) {
+            kind = SLEEPWEAR;
+        } else {
+            return null;
+        }
+
+        String hash = SWIMWEAR.equals(kind) ? villager.getSwimwearOutfit() : villager.getSleepwearOutfit();
+        return OutfitStore.textureForHash(hash);
+    }
+}
