+
+    @Override
+    public void onClose() {
+        if (popup != null) {
+            closePopup();
+            return;
+        }
+        Minecraft.getInstance().setScreen(previous);
+    }
+
+    private int tileX(int tile) {
+        return width / 2 + (int) ((tile % COLUMNS - COLUMNS / 2.0 + 0.5) * 58);
+    }
+
+    private int tileY(int tile) {
+        return 120 + (tile / COLUMNS) * 100;
+    }
+
+    private boolean over(int tile, double mx, double my) {
+        int cx = tileX(tile);
+        int cy = tileY(tile);
+        return Math.abs(cx - mx) <= 28 && my >= cy - 62 && my <= cy + 6;
+    }
+
+    private boolean tileExists(int tile) {
+        return page * PER_PAGE + tile < tiles.size();
+    }
+
+    private OutfitStore.Outfit tileOutfit(int tile) {
+        return tiles.get(page * PER_PAGE + tile);
+    }
+
+    private boolean isSelected(int tile) {
+        if (tab.equals(SAVED) || tab.equals(MOD)) return false;
+        String chosen = chosenHash(tab);
+        OutfitStore.Outfit o = tileOutfit(tile);
+        return o == null ? chosen.isEmpty() : o.hash().equals(chosen);
+    }
+
+    private void drawPreview(GuiGraphics context, OutfitStore.Outfit outfit, int cx, int cy, int scale, float lookX, float lookY) {
+        preview.readAdditionalSaveData(baseData.copy());
+        preview.setAge(0);
+        preview.getGenetics().setGender(gender.binary());
+        if (outfit != null) {
+            preview.setClothes(outfit.texture());
+        }
+        InventoryScreen.renderEntityInInventoryFollowsMouse(context, cx, cy, scale, lookX, lookY, preview);
+    }
+
+    @Override
+    public void render(GuiGraphics context, int mouseX, int mouseY, float delta) {
+        renderBackground(context);
+
+        if (popup != null) {
+            context.drawCenteredString(font, Component.literal(popup.label()), width / 2, 40, 0xFFFFFFFF);
+            int cx = width / 2 - 70;
+            int cy = height / 2 + 70;
+            drawPreview(context, popup, cx, cy, 70, -(mouseX - cx) / 2.0f, -(mouseY - cy + 100) / 2.0f);
+            super.render(context, mouseX, mouseY, delta);
+            return;
+        }
+
+        context.drawCenteredString(font, Component.translatable("gui.mca.outfits.help." + tab), width / 2, 38, 0xFFCCCCCC);
+
+        Component tooltip = null;
+        for (int tile = 0; tile < PER_PAGE && tileExists(tile); tile++) {
+            int cx = tileX(tile);
+            int cy = tileY(tile);
+            OutfitStore.Outfit outfit = tileOutfit(tile);
+            boolean hovered = over(tile, mouseX, mouseY);
+
+            if (isSelected(tile)) {
+                context.fill(cx - 28, cy - 66, cx + 28, cy + 8, 0x6655FF55);
+            } else if (hovered) {
+                context.fill(cx - 28, cy - 66, cx + 28, cy + 8, 0x33FFFFFF);
+            }
+            if (hovered) {
+                tooltip = outfit == null ? Component.translatable("gui.mca.outfits.normal") : Component.literal(outfit.label());
+            }
+            drawPreview(context, outfit, cx, cy, hovered ? 32 : 30, -(mouseX - cx) / 2.0f, -(mouseY - cy + 30) / 2.0f);
+            if (outfit != null) {
+                String label = font.plainSubstrByWidth(outfit.label(), 54);
+                context.drawCenteredString(font, label, cx, cy + 12, 0xFFDDDDDD);
+            }
+        }
+
+        if (tiles.isEmpty()) {
+            context.drawCenteredString(font, Component.translatable("gui.mca.outfits.empty"), width / 2, height / 2, 0xFFFFAA55);
+        } else if (!tab.equals(SAVED) && !tab.equals(MOD) && tiles.size() == 1) {
+            context.drawCenteredString(font, Component.translatable("gui.mca.outfits.empty_tab"), width / 2, height / 2 + 60, 0xFFFFAA55);
+        }
+
+        super.render(context, mouseX, mouseY, delta);
+
+        if (tooltip != null) {
+            context.renderTooltip(font, tooltip, mouseX, mouseY);
+        }
+    }
+
+    @Override
+    public boolean mouseClicked(double mouseX, double mouseY, int button) {
+        if (super.mouseClicked(mouseX, mouseY, button)) {
+            return true;
+        }
+        if (popup != null) {
+            return false;
+        }
+        for (int tile = 0; tile < PER_PAGE && tileExists(tile); tile++) {
+            if (!over(tile, mouseX, mouseY)) continue;
+            OutfitStore.Outfit outfit = tileOutfit(tile);
+            if (tab.equals(SAVED) || tab.equals(MOD)) {
+                popup = outfit;
+                rebuildWidgets();
+            } else if (outfit == null) {
+                choose(null);
+            } else if (button == 1) {
+                popup = outfit;
+                rebuildWidgets();
+            } else {
+                choose(outfit);
+            }
+            return true;
+        }
+        return false;
+    }
+}
