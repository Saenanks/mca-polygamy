+/**
+ * Vanilla "sleep in bed" with a short bedtime routine for adult villagers that have a sleepwear outfit chosen, when a player is nearby:
+ * <ol>
+ *   <li>she stops at the bed and says a line,</li>
+ *   <li>2 seconds later she changes into her sleepwear (see SpecialOutfits),</li>
+ *   <li>4 seconds later she gets into bed.</li>
+ * </ol>
+ * A Deviant spouse of the player does a little show instead of the 4 seconds: she twirls, faces him again for a second, puts her hands on her
+ * breasts and jiggles them up and down three times (the model and BreastPhysics draw that, see BedtimeAnimation), lowers her hands and lets
+ * them settle while she turns her back to him and sneaks up and down a few times, turns around and says one more line, and 2 seconds later gets
+ * into bed. Without a player nearby she just goes to sleep.
+ */
+public class BedtimeSleepTask extends SleepInBed {
+    private static final int LINE_DELAY = 40;
+    private static final int SLEEP_DELAY = 80;
+    private static final int TWIRL_TICKS = 25;
+    private static final int FACE_TICKS = 25;
+    /** Three bobs of the hands, see BedtimeAnimation. */
+    private static final int HANDS_UP_TICKS = 28;
+    private static final int HANDS_DOWN_TICKS = 10;
+    private static final int TURN_TICKS = 15;
+    /** She ducks (sneaks) this many times, staying down and up for SNEAK_HALF ticks each. */
+    private static final int SNEAKS = 3;
+    private static final double SNEAK_HALF = 8 / 1.2;
+    /** She stands with her back to him this long before the first duck. */
+    private static final int SNEAK_WAIT = 20;
+    private static final int AFTER_TICKS = 80;
+    private static final double AUDIENCE_RANGE = 8.0;
+
+    private enum Phase {IDLE, TALKING, CHANGING, TWIRL, FACE, HANDS_UP, HANDS_DOWN, TURN_AWAY, SNEAK, TURN_BACK, AFTER, SLEEPING}
+
+    private Phase phase = Phase.IDLE;
+    private long phaseStart;
+    private ServerPlayer focus;
+    private boolean show;
+    private float baseYaw;
+    private float awayYaw;
+
+    @Override
+    protected void start(ServerLevel level, LivingEntity entity, long time) {
+        phase = Phase.SLEEPING;
+        if (entity instanceof VillagerEntityMCA villager
+                && villager.isSleepwearSet()
+                && !villager.isBaby()
+                && DeviantLines.isAdult(villager.getAgeState())
+                && !villager.isSleeping()) {
+            // every player nearby gets a line that fits their relationship with her: the married lines only go to her
+            // spouse, everyone else hears the plain comfy ones
+            focus = null;
+            show = false;
+            boolean spoke = false;
+            for (ServerPlayer player : level.players()) {
+                if (player.isSpectator() || player.distanceToSqr(villager) > AUDIENCE_RANGE * AUDIENCE_RANGE) {
+                    continue;
+                }
+                String line = BedtimeLines.pick(villager, player);
+                if (line == null) {
+                    continue;
+                }
+                villager.sendChatMessage(Component.literal(line), player);
+                spoke = true;
+                boolean spouse = villager.getRelationships().isMarriedTo(player.getUUID());
+                boolean focusIsSpouse = focus != null && villager.getRelationships().isMarriedTo(focus.getUUID());
+                if (focus == null || (spouse && !focusIsSpouse)
+                        || (spouse == focusIsSpouse && player.distanceToSqr(villager) < focus.distanceToSqr(villager))) {
+                    focus = player;
+                }
+                if (BedtimeLines.isDeviantSpouse(villager, player)) {
+                    show = true;
+                    focus = player;
+                }
+            }
+            if (spoke) {
+                villager.getBrain().setMemory(MemoryModuleType.LOOK_TARGET, new EntityTracker(focus, true));
+                enter(Phase.TALKING, time);
+                freeze(villager);
+                return;
+            }
+        }
+        super.start(level, entity, time);
+    }
+
+    private void enter(Phase next, long time) {
+        phase = next;
+        phaseStart = time;
+    }
+
+    private boolean inRoutine() {
+        return phase != Phase.IDLE && phase != Phase.SLEEPING;
+    }
+
+    @Override
+    protected boolean canStillUse(ServerLevel level, LivingEntity entity, long time) {
+        if (inRoutine()) {
+            Optional<GlobalPos> home = entity.getBrain().getMemory(MemoryModuleType.HOME);
+            return home.isPresent()
+                    && entity.getBrain().isActive(Activity.REST)
+                    && !entity.isSleeping()
+                    && home.get().pos().closerToCenterThan(entity.position(), 2.5);
+        }
+        return super.canStillUse(level, entity, time);
+    }
+
+    @Override
+    protected void tick(ServerLevel level, LivingEntity entity, long time) {
+        if (!(entity instanceof VillagerEntityMCA villager) || !inRoutine()) {
+            return;
+        }
+        freeze(villager);
+        long elapsed = time - phaseStart;
+        switch (phase) {
+            case TALKING -> {
+                if (elapsed >= LINE_DELAY) {
+                    villager.setBedtimeOutfit(true);
+                    if (show && focus != null && !focus.isRemoved()) {
+                        baseYaw = yawTo(villager, focus);
+                        villager.getBrain().eraseMemory(MemoryModuleType.LOOK_TARGET);
+                        villager.setBedtimeAnim(1);
+                        enter(Phase.TWIRL, time);
+                    } else {
+                        enter(Phase.CHANGING, time);
+                    }
+                }
+            }
+            case CHANGING -> {
+                if (elapsed >= SLEEP_DELAY) {
+                    goToBed(level, villager, time);
+                }
+            }
+            case TWIRL -> {
+                float t = Mth.clamp((float) elapsed / TWIRL_TICKS, 0.0F, 1.0F);
+                float eased = t * t * (3.0F - 2.0F * t);
+                setRotation(villager, baseYaw + 360.0F * eased);
+                if (elapsed >= TWIRL_TICKS) {
+                    setRotation(villager, baseYaw);
+                    lookAtFocus(villager);
+                    villager.setBedtimeAnim(0);
+                    enter(Phase.FACE, time);
+                }
+            }
+            case FACE -> {
+                // a moment to let the torso turn to face the player before the hands go up
+                faceFocus(villager);
+                if (elapsed >= FACE_TICKS) {
+                    villager.setBedtimeAnim(2);
+                    enter(Phase.HANDS_UP, time);
+                }
+            }
+            case HANDS_UP -> {
+                faceFocus(villager);
+                if (elapsed >= HANDS_UP_TICKS) {
+                    villager.setBedtimeAnim(3);
+                    enter(Phase.HANDS_DOWN, time);
+                }
+            }
+            case HANDS_DOWN -> {
+                faceFocus(villager);
+                if (elapsed >= HANDS_DOWN_TICKS) {
+                    villager.setBedtimeAnim(4);
+                    villager.getBrain().eraseMemory(MemoryModuleType.LOOK_TARGET);
+                    baseYaw = focusYaw(villager);
+                    enter(Phase.TURN_AWAY, time);
+                }
+            }
+            case TURN_AWAY -> {
+                float t = Mth.clamp((float) elapsed / TURN_TICKS, 0.0F, 1.0F);
+                float target = focusYaw(villager) + 180.0F;
+                setRotation(villager, baseYaw + Mth.wrapDegrees(target - baseYaw) * (t * t * (3.0F - 2.0F * t)));
+                if (elapsed >= TURN_TICKS) {
+                    awayYaw = target;
+                    villager.getBrain().eraseMemory(MemoryModuleType.LOOK_TARGET);
+                    villager.setBedtimeAnim(0);
+                    enter(Phase.SNEAK, time);
+                }
+            }
+            case SNEAK -> {
+                awayYaw = focusYaw(villager) + 180.0F;
+                setRotation(villager, awayYaw);
+                setSneak(villager, elapsed >= SNEAK_WAIT && (elapsed - SNEAK_WAIT) % (2 * SNEAK_HALF) < SNEAK_HALF);
+                if (elapsed >= SNEAK_WAIT + 2 * SNEAK_HALF * SNEAKS) {
+                    setSneak(villager, false);
+                    enter(Phase.TURN_BACK, time);
+                }
+            }
+            case TURN_BACK -> {
+                float t = Mth.clamp((float) elapsed / TURN_TICKS, 0.0F, 1.0F);
+                setRotation(villager, awayYaw + Mth.wrapDegrees(focusYaw(villager) - awayYaw) * (t * t * (3.0F - 2.0F * t)));
+                if (elapsed >= TURN_TICKS) {
+                    faceFocus(villager);
+                    lookAtFocus(villager);
+                    if (focus != null && !focus.isRemoved()) {
+                        String line = BedtimeLines.pickAfterShow(villager, focus);
+                        if (line != null) {
+                            villager.sendChatMessage(Component.literal(line), focus);
+                        }
+                    }
+                    enter(Phase.AFTER, time);
+                }
+            }
+            case AFTER -> {
+                faceFocus(villager);
+                if (elapsed >= AFTER_TICKS) {
+                    goToBed(level, villager, time);
+                }
+            }
+            default -> {
+            }
+        }
+    }
+
+    private void goToBed(ServerLevel level, VillagerEntityMCA villager, long time) {
+        phase = Phase.SLEEPING;
+        villager.setBedtimeAnim(0);
+        setSneak(villager, false);
+        if (super.checkExtraStartConditions(level, villager)) {
+            super.start(level, villager, time);
+        }
+    }
+
+    @Override
+    protected void stop(ServerLevel level, LivingEntity entity, long time) {
+        super.stop(level, entity, time);
+        if (entity instanceof VillagerEntityMCA villager) {
+            villager.setBedtimeAnim(0);
+            setSneak(villager, false);
+            if (!villager.isSleeping()) {
+                villager.setBedtimeOutfit(false);
+            }
+        }
+        phase = Phase.IDLE;
+        focus = null;
+    }
+
+    /** The crouch pose is what the renderer looks at. */
+    private static void setSneak(VillagerEntityMCA villager, boolean down) {
+        villager.setShiftKeyDown(down);
+        if (down) {
+            villager.setPose(net.minecraft.world.entity.Pose.CROUCHING);
+        } else if (villager.getPose() == net.minecraft.world.entity.Pose.CROUCHING) {
+            villager.setPose(net.minecraft.world.entity.Pose.STANDING);
+        }
+    }
+
+    /** Stand still: no walking, the movement control keeps her where she is. */
+    private static void freeze(VillagerEntityMCA villager) {
+        villager.getNavigation().stop();
+        villager.getBrain().eraseMemory(MemoryModuleType.WALK_TARGET);
+        villager.getMoveControl().setWantedPosition(villager.getX(), villager.getY(), villager.getZ(), 0.0);
+    }
+
+    private static void setRotation(VillagerEntityMCA villager, float yaw) {
+        villager.setYRot(yaw);
+        villager.yBodyRot = yaw;
+        villager.setYHeadRot(yaw);
+    }
+
+    private float focusYaw(VillagerEntityMCA villager) {
+        return focus != null && !focus.isRemoved() ? yawTo(villager, focus) : villager.getYRot();
+    }
+
+    private static float yawTo(VillagerEntityMCA villager, ServerPlayer player) {
+        double dx = player.getX() - villager.getX();
+        double dz = player.getZ() - villager.getZ();
+        return (float) (Mth.atan2(dz, dx) * (180.0F / Math.PI)) - 90.0F;
+    }
+
+    private void faceFocus(VillagerEntityMCA villager) {
+        if (focus != null && !focus.isRemoved()) {
+            setRotation(villager, yawTo(villager, focus));
+        }
+    }
+
+    private void lookAtFocus(VillagerEntityMCA villager) {
+        if (focus != null && !focus.isRemoved()) {
+            villager.getBrain().setMemory(MemoryModuleType.LOOK_TARGET, new EntityTracker(focus, true));
+        }
+    }
+}
